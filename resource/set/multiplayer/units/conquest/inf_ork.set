;SDL
; Ork conquest infantry rebalance overlay.
; Economy targets mirror Tyr balancing pass:
; - T1 core infantry: 1 helmet each.
; - T2 specialists: 2 helmets each, 50+ shields each.
; - T3 elites/heroes: 3 helmets each, around 200 shields each.
; - T4 heavies/bosses: 10+ helmets each, 600+ shields each.

(define "lvork_t1_core"
	("sc_inf_tier_cx" period(early) side(ork) cpm(1.0) cwm(0.5))
	{cost %cost}
)

(define "lvork_t1_crew"
	("sc_inf_tier_cx" period(early) side(ork) cpm(1.0) cwm(0.5))
	{cost %cost}
)

(define "lvork_t2_special"
	("sc_inf_tier_cx" period(early) side(ork) cpm(2.0) cwm(1.5))
	{cost %cost}
)

(define "lvork_t3_elite"
	("sc_inf_tier_cx" period(early) side(ork) cpm(3.0) cwm(2.5))
	{cost %cost}
)

(define "lvork_t4_heavy"
	("sc_inf_tier_cx" period(early) side(ork) cpm(10.0) cwm(8.0))
	{cost %cost}
)

(define "lvork_t4_boss"
	("sc_inf_tier_cx" period(early) side(ork) cpm(12.0) cwm(10.0))
	{cost %cost}
)

(define "ork_defense_inf"
	{basic}
	{breed}
	{tags "early %side infantry man lvl1 lvl2 lvl3"}
	{cp 1}
	{cw 0.5}
	{score_factor 0.05}
	{cost %cost}
)

