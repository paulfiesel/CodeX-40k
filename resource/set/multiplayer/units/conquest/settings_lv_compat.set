; Bounded Last Victim Conquest card macros for the supported Imperium, Ork,
; and Tyranid campaign setup. These wrappers intentionally cover only the
; four LV source families loaded by roster_conquest.set.

(define "conquest_squad"
	{charge {delay 0}{interval 0}}
	{tags "conquest conquestonly %side %period %tag"}
	{level 1}
	{cost 0}
	{research_stage %min_stage}
	{research_stage_max %max_stage}
	{squad_cost_factor 1}
	{button "%button"}
)

(define "conquest_vehicle"
	{charge {delay 0}{interval 0}}
	{tags "conquest conquestonly %side %period %tag"}
	{level 1}
	{cost 0}
	{research_stage %min_stage}
	{research_stage_max %max_stage}
	{squad_cost_factor 1}
	{round_multiple 5.0}
	{button "%button"}
	{cw %cw}
	{cp %cp}
)

(define "conquest_squad_manual"
	{charge {delay 0}{interval 0}}
	{tags "conquest conquestonly %side %period %tag"}
	{level 1}
	{cost %cost}
	{cp %cp}
	{research_stage %min_stage}
	{research_stage_max %max_stage}
	{squad_cost_factor 0.05}
	{round_multiple 1.0}
	{button "%button"}
)

(define "conquest_vehicle_costed"
	{charge {delay 0}{interval 0}}
	{tags "conquest conquestonly %side %period %tag"}
	{level 1}
	{cost %cost}
	{research_stage %min_stage}
	{research_stage_max %max_stage}
	{squad_cost_factor 1}
	{round_multiple 5.0}
	{button "%button"}
	{cw %cw}
	{cp %cp}
)

(define "conquest_vehicle_manual"
	{charge {delay 0}{interval 0}}
	{tags "conquest conquestonly %side %period %tag"}
	{level 1}
	{cost %cost}
	{research_stage %min_stage}
	{research_stage_max %max_stage}
	{squad_cost_factor 0.05}
	{round_multiple 1.0}
	{button "%button"}
	{cw %cw}
	{cp %cp}
)

; Infantry cards whose breeds live under LV's packed multiplayer namespace.
(define "sc_inf_squad_with1types_doc"
	("conquest_squad" side(%side) period(%period) tag(%t) min_stage(1) max_stage(99) button(%b))
	{content "mp/[SC_DLC_%package]/[MP]/%side_mp/%c1"}
)

(define "sc_inf_squad_with2types_doc"
	("conquest_squad" side(%side) period(%period) tag(%t) min_stage(1) max_stage(99) button(%b))
	{content "mp/[SC_DLC_%package]/[MP]/%side_mp/%c1 mp/[SC_DLC_%package]/[MP]/%side_mp/%c2"}
)

