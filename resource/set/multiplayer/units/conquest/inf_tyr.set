;SDL
; Tyranid conquest infantry rebalance overlay.
; Economy targets:
; - Gaunt lines: 1 helmet each (Termagants near Cadian shield baseline).
; - T2 synapse infantry: 2 helmets each, 50+ shields each.
; - T3 elite infantry: 3 helmets each, around 200 shields each.
; - T4 monsters/apexes: 10+ helmets each, 600+ shields each.

(define "lvtyr_t1_ripper"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(1.0) cwm(0.5))
	{cost 0}
)

(define "lvtyr_t1_gaunt"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(1.0) cwm(0.5))
	{cost %cost}
)

(define "lvtyr_t2_synapse"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(2.0) cwm(1.5))
	{cost %cost}
)

(define "lvtyr_t3_elite"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(3.0) cwm(2.5))
	{cost %cost}
)

(define "lvtyr_t3_psyker"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(3.0) cwm(3.0))
	{cost %cost}
)

(define "lvtyr_t4_monster"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(10.0) cwm(8.0))
	{cost %cost}
)

(define "lvtyr_t4_apex"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(12.0) cwm(10.0))
	{cost %cost}
)

(define "lvtyr_t4_legend"
	("sc_inf_tier_cx" period(early) side(tyr) cpm(14.0) cwm(12.0))
	{cost %cost}
)

(define "tyr_defense_inf"
	{basic}
	{breed}
	{tags "early %side infantry man lvl1 lvl2 lvl3"}
	{cp 1}
	{cw 0.5}
	{score_factor 0.05}
	{cost %cost}
)

; Tyranid defender infantry pool for campaign defense placements.
{"[SC_DLC_LV40k]/[MP]/-tyr/leviathan/t0_gaunt/tyr_leviathan_t0_01"
	("tyr_defense_inf" side(tyr) cost(5))
}
{"[SC_DLC_LV40k]/[MP]/-tyr/leviathan/t0_gaunt/tyr_leviathan_t0_02"
	("tyr_defense_inf" side(tyr) cost(5))
}
{"[SC_DLC_LV40k]/[MP]/-tyr/leviathan/t0_gaunt/tyr_leviathan_t0_03"
	("tyr_defense_inf" side(tyr) cost(5))
}
{"[SC_DLC_LV40k]/[MP]/-tyr/leviathan/t0_gaunt/tyr_leviathan_t0_04"
	("tyr_defense_inf" side(tyr) cost(5))
}

