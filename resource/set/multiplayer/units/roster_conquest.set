; Code:X Dynamic Conquest roster plus the custom Imperium overlay.
{units
	; Shared campaign templates.
	(include "conquest/settings.set")
	(include "conquest/settings_lv_compat.set")
	(include "conquest/settings_inf_lv_compat.set")

	; Code:X infantry tuning.
	(include "conquest/inf_ukr.set")
	(include "conquest/inf_rusa.set")
	(include "conquest/inf_nato.set")
	(include "conquest/inf_prc_era1960.set")
	(include "conquest/inf_sov_era1960.set")
	(include "conquest/inf_csa_era1960.set")
	(include "conquest/inf_frg_era1960.set")

	; Supported Last Victim factions only. Do not include SC_DLC_LV40k.set here:
	; its aggregate imports Space Marines and unreleased armies outside this matrix.
	(include "SC_DLC_LV40k/inf_ork.inc")
	(include "SC_DLC_LV40k/inf_tyr.inc")
	(include "SC_DLC_LV40k/units_ork_evz.inc")
	(include "SC_DLC_LV40k/units_tyr_lev.inc")

	; Code:X campaign cards.
	(include "conquest/units_ukr.set")
	(include "conquest/units_rusa.set")
	(include "conquest/units_nato.set")
	(include "conquest/units_sov_era1960.set")
	(include "conquest/units_csa_era1960.set")
	(include "conquest/units_frg_era1960.set")
	(include "conquest/units_prc_era1960.set")

	; User-authored combined Imperium campaign cards.
	(include "conquest/units_imp.set")
}
