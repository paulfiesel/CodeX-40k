;_________________________________________
; Soviet 'Katusha' Medium Rocket Artillery
;=========================================


{from "pattern reactive"		; "BM-21" with short-range rockets
	{filling "ammo rocket122" 40}
	{fireSound "reactive/katy_burst/"}
	{calibre 122}

	("rocket_artillery")
	
	{range 400 400} ;//15km
	{minRange 100}
	("mrls_velocity" ap(1400) he(114))
	("mrls_gravity" ap(280) he(2.2))
	{burst 
		{min 4}
		{noaiming}
	}

	("fire rate" rpm(120))
	("reload time" seconds(160))
	("relaxationtime" rt(3))
	{parameters "cl"
		("CW_acc_artillery" mils(5))	;оценка
		{cursor "burn"}
		{cursorReloading "cannon_reload_heat_timer_160"}
	}
	{parameters "fg"
		("CW_acc_guided" kvo_meters(6))	
		{cursor "cannon_on_fg_14"}
		{cursorReloading "cannon_reload_fg_timer_160"}
	}
	
}