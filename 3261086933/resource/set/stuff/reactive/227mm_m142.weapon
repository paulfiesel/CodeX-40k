; German Light Rocket Artillery
;=========================================


{from "pattern reactive"		; "227mm_himars"
	{tag "gun"}
	{filling "ammo 227mm_m26" 6}
	{fireSound "reactive/mlrs/mlrs_burst/"}
	{calibre 227}

	("rocket_artillery")

	{spreading
		{radiusTable
			{0 0}
			{100 3}
			{500 8}
			{950 7} ;// max range
			{345 14}
			{365 16}
		}
	}
	{burst
		{min 3}
		{noaiming}
	}
	{gravity 1.5}

	{minRange 50}
	{aimRange 950}
	{maxRange 950} ;//7,85km
	("velocity" mps(320))
	("reload time" seconds(120))
	("fire rate" rpm(37.5)) ;// 8s to fire full salvo
}