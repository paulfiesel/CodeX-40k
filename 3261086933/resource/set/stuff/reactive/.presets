(define "speed_mrls" {speed 85})

(define "global velocity_mrl"
	{speed (* 0.75 %gv)}			;// Global muzzle velocity scale for all weapons in "gun" folder.
)

(define "mrls_velocity"

	("global velocity_mrl" gv(%he))
	{parameters "cl"		("global velocity_mrl" gv(%ap))}
	{parameters "fg"		("global velocity_mrl" gv(%he))}

)

(define "global gravity_mrl"
	{gravity  %grv}
)

(define "mrls_gravity"				
	("global gravity_mrl" grv(%he))		

	{parameters "cl"		("global gravity_mrl" grv(%ap))}
	{parameters "fg"		("global gravity_mrl" grv(%he))}
)

(define "speed_mrls" {speed 180})

