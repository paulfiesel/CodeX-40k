(define "zoom_svd"
	{thirdpersonparams inherit "human default"
			{level 1
				{linkBone	"head"	}
				{distanceset 		40}
				{distance			40}	; activation distance
				{delta		20		}		; distance delta
				{nearspace_views 	"fps_arms"	}
				{nearspace_weapon	1	}
				{camera "human_zoom1.25"}
				;{offset		0 12 4.5}
				{offset		39.6 1.5 1.3	}
				{blur_strength 10}
				{hide_hitmarker 1}
				{forceGrass 0}
				{disable_fow 0}
				{with_owner
					{viewoff 	"head"	}
					{boneon 	"fps_arms"	}
				}
				{with_weapon
					{viewoff	"fx_light"}
					{viewon 	"fps_arms"	}
				}
				;{vignette	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01"}
				;{blur_mask	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
				{no_grain}
				{no_rim_light}
			}
			{level 2
				{camera "human_zoom4"}
				{scope_vignette "/texture/common/environment/lens_effects/zoom_vignette_infantry_pso"}
				{blur_mask "/texture/common/environment/lens_effects/zoom_vignette_scope_01_mask"}
				{bump_spec_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_pso"}
				{refraction_mask "/texture/common/environment/lens_effects/zoom_vignette_scope_01_bp"}
				{lens_dirt_mask "/texture/common/environment/lens_effects/dirty_lens_scope_01"}
				{vignette_gloss 5}
				{offset		2.5 2.25 0.75	}
				{hide_weapon 1}
				{with_owner
					{viewoff 	"fps_arms"	}
				}
				{with_weapon
					{viewon		"foresight3"}
				}
				{hide_crosshair}
				{weapon_sway_active}
				{blur_strength 1}
				;{enable_special} ; enable aimed shot
				{aimer_type "sniper"}
			}
			
		}


)

