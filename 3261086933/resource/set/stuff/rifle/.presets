(define "battle_rifle" ;full size rifle calibers with full auto capability; FN FAL
	{tag "autorifle_sup auto_eject rifle_shell"}
	{range 115 115}
	{spreading
		{BurstAccuracy 90 80 70 60 50 40}
	}
	{burst
		{short 2 0.5}		; burst shots on long distance, rand (+-)shots
		{long 6 3}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.55}		; rangeKoef * aimRange = max long burst distance
	}

	("accuracy_rifle_auto")
	{LockFireDistanceTime 0.5}
	("penetration" args 9 5)
	("human health" damage(70))
	("armor health" damage(25))
	{SyncedProjectiles 0}		;// not for automatic weapons
	{FiringTimeout 2 0.5}
	{curve "autorifle"}
	("recoil_rifle_semi")
	("ap_7_62_slope_multiplier")
)

