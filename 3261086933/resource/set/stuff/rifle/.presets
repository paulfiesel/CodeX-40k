
(include "\set\small_firearms_accuracy.inc")

(define "penetration"
	{projectileDamageTable 	{30 %0} {110 %1} {250 0}}
)

(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)

(define "semi_rifle" ;full size rifle calibers, semi-auto only ;M1 Garand, M14, L1A1 SLR
	{tag "auto_eject rifle_shell"}
	{range 115 115}
	{spreading 
		{BurstAccuracy 100 90 80 70 60}
	}
	{burst
		{short 3 3}		; burst shots on long distance, rand (+-)shots
		{long 3 3}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.55}	; rangeKoef * aimRange = max long burst distance
	}
	("fire rate" rpm(150))
	("zeroing_boost")
	("accuracy_rifle_auto")
	("penetration" args 5.0 3.0)
	("human health" damage(70))
	("armor health" damage(5))
	{FiringTimeout 2 0.5}
	{curve "autorifle"}
	("recoil_rifle_semi")
	("ap_7_62_slope_multiplier")
)

(define "semi_rifle_inter" ;Intermediate power rifle calibers, semi-auto only ;SKS
	{tag "auto_eject rifle_shell"}
	{range 115 115}
	{spreading 
		{BurstAccuracy 110 100 90 80 70}
	}
	{burst
		{short 3 0.5}		; burst shots on long distance, rand (+-)shots
		{long 5 2}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.55}	; rangeKoef * aimRange = max long burst distance
	}

	("fire rate" rpm(175))
	("zeroing_boost")
	("accuracy_rifle_auto")
	("penetration" args 5.0 3.0)
	("human health" damage(60))
	("armor health" damage(5))
	
	{curve "autorifle"}
	("recoil_rifle_semi")
	("ap_7_62_slope_multiplier")
)

