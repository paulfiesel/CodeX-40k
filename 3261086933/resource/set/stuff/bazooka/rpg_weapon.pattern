;SDL
{weapon_bullet
	{tag "rocketlauncher to_hand ap cannot_lie low_speed"} ;removed "nokeep"?
	{inventory
		{size 8 2}
		{link_bone "gun_back"}
		{weight 100}
		{fsm "bazooka"}
	}

	{states
		{reload "reload-bazooka"}
		{unload "unload-bazooka"}
		{fire "fire-bazooka"}
		{aim "aim-bazooka"}
		{can_aim "can-aim-bazooka"}
	}

    {cursor "cannon_on_heat"}
	{cursorReloading "cannon_reload_heat"}	
	{foresight "foresight3"}

	{preloaded}


	{curve "gun_std"}
	;{AimingTolerance 3}
	{AimingTolerance 0.5}
	{unlimitedRangeTPC 0}
	{projectileDamageThreshold 1}
	{DisableRicochet}
	("fire rate" rpm(6))
	("reload time" seconds(10))

	{gravity 0.75}

	{spreading 1.75
		{SpreadPower 2}
		{SpreadXYRatio 0.7}
		{SpreadYadjust 0}
		{radiusFunction
			0.0		0
			0.85	0.9
			1.0		1.3
			1.2		6
			2		30
		}
	}

	{ZeroingAccuracy 0.7 0.6 0.5 0.4}

	{overmatchSlope
		{0 1}
		{90 1}
	}

	{FiringTimeout 11 3}	; min delay between ai shots (note: will be affected by "grenade_timeout" modifier)
	{AccuracyByMotionK 0.1}

;	{crosshair ""}
;	{crosshairReloading ""}
	{SyncedProjectiles 1} 			;// visually syncs decal/crater spawn in multiplayer
}
