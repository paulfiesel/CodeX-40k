{from "pattern rpg_weapon"
	{filling "ammo rpg7l" 1}
	{fillingVisible "rocket"}
	{entity "rpg-7v"}
	{fireSound "reactive/rpg7/"}
	{reloadsound "bazooka"}
	{calibre 93}
	{mass 13.9}

	("reload time" seconds(8))
	("velocity" mps(200))
	{range 100 100}
	
	{spreading 1.4}
	("accuracy_optic_rpg"  moa(4.97))
	("penetration" args 500) ;PG-7L
	("armor health" damage(300))
	("human health" damage(300))
	("pointed_slope")

	{parameters "tbg"
		("accuracy_optic_rpg"  moa(5.97))
		{cursor "shmel_on"}
	        {cursorReloading "cannon_reload_fg"}											;http://www.reyndar.org/~reyndar1/rpg.pdf
	}
	{parameters "he"
	             {cursorReloading "cannon_reload_fg"}	
	}
	{parameters "vr"
	             ("penetration" args 750) ;PG-7L
	}	


	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.25"}
			;{offset		0 12 4.5}
			{offset		39.6 1.5 1.9	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 1}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			;{vignette	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01"}
			;{blur_mask	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{no_grain}
			{no_rim_light}
		}
		{level 2
			{camera "human_zoom4"}
			{scope_vignette		"/texture/common/environment/lens_effects/zoom_vignette_infantry_rpg7_scope"}
			{blur_mask		"/texture/common/environment/lens_effects/zoom_vignette_scope_02_mask"}
			{bump_spec_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_rpg7_scope"}
			{offset		2.5 2.25 0.75	}
			{hide_weapon 1}
			{hide_crosshair}
			{with_owner
				{viewoff 	"fps_arms"	}
			}
			{with_weapon
				{viewon		"foresight3"}
			}
			{weapon_sway_active}
			{blur_strength 1}
		}
	} 
}
