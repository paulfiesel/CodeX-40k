{from "pattern rpg_weapon"
	{filling "ammo rpg7" 1}
	{fillingVisible "rocket"}
	{entity "rpg_7"}
	{fireSound "reactive/rpg7/"}
	{reloadsound "bazooka"}
	{calibre 85}
	{mass 13.9}
	("reload time" seconds(8))

	("velocity" mps(115))
	{range 90 90}
	{parameters "tbg"
		("accuracy_optic_rpg"  moa(5.97))
		{cursor "shmel_on"}
	        {cursorReloading "cannon_reload_fg"}											;http://www.reyndar.org/~reyndar1/rpg.pdf
	}
	{parameters "he"
	             {cursorReloading "cannon_reload_fg"}	
	}	
	{spreading 1.4}
	("pointed_slope")
	("penetration" args 260)
	("armor health" damage(260))
	("human health" damage(260))
	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.25"}
			;{offset		0 12 4.5}
			{offset		39.6 1.5 0.9	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 1}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			;{vignette	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01"}
			;{blur_mask	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{no_grain}
			{no_rim_light}
		}
		{level 2
			{camera "human_zoom4"}
			{scope_vignette		"/texture/common/environment/lens_effects/zoom_vignette_infantry_rpg7"}
			{blur_mask		"/texture/common/environment/lens_effects/zoom_vignette_scope_02_mask"}
			{bump_spec_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_rpg7"}
			{offset		3.5 1.0 0.75	}
			{hide_weapon 1}
			{hide_crosshair}
			{with_owner
				{viewoff 	"fps_arms"	}
			}
			{with_weapon
				{viewon		"foresight3"}
			}
			{weapon_sway_active}
			{blur_strength 1}
		}
	} 
}
