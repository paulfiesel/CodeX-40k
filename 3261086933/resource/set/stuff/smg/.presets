(include "\set\small_firearms_accuracy.inc")

(define "burst_short"
	{burst
		{short 8 4}
		{long 12 6}
		{rangeKoef 0.4}
	}
)

(define "burst_short_slow"
	{burst
		{short 8 4}
		{long 12 6}
		{rangeKoef 0.4}
	}
	{FiringTimeoutDistanceFactor
		{0.25 0.55}	;20m, 1.1s
		{0.7 0.85}	;56m, 1.7s
		{1.0 0.95}	;80m, 1.9s
	}
)

(define "burst_long"
	{burst
		{short 12 6}
		{long 16 8}
		{rangeKoef 0.4}
	}
)

(define "stick_reload"
	("reload time" seconds(3.25))
)

(define "drum_reload"
	("reload time" seconds(4.5))
)

(define "spreading_mounted"
	{spreading
		{BurstAccuracy 100 95 90 85 80 75 70 65 60}
	}
)
(define "spreading_low"
	{spreading
		{BurstAccuracy 100 95 90 85 80 75 70 65 60 55 53 50}
	}
)
(define "spreading_medium"
	{spreading 
		{BurstAccuracy 100 93 86 79 72 66 60 55 50 46 43 40}
	}
)
(define "spreading_high"
	{spreading 
		{BurstAccuracy 100 92 84 76 69 62 56 49 43 36 33 30}
	}
)
(define "spreading_max"
	{spreading 
		{BurstAccuracy 100 91 82 73 65 57 51 45	40}
	}
)

(define "penetration"
	{projectileDamageTable 	{25 %0} {100 0}}
)

(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)

(define "zoom_defaut"	
	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.5"}
			;{offset		0 12 4.5}
			{offset		39.6 1.5 1.2	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 0}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			;{vignette	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01"}
			;{blur_mask	"/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{no_grain}
			{no_rim_light}
		}
		
	}
)

(define "zoom_mp5"
	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.25"}
			;{offset		0 12 4.5}
			{offset		39.6 1.5 0.7	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 0}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			{no_grain}
			{no_rim_light}
		}
		{level 2
			{camera "human_zoom1.5"}
			{scope_vignette "/texture/common/environment/lens_effects/zoom_vignette_infantry_mp5"}
			{blur_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{bump_spec_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_mp5"}
			{vignette_gloss 15}
			{offset		2.5 2.25 0.75	}
			{hide_weapon 1}
			{with_owner
				{viewoff 	"fps_arms"	}
			}
			{with_weapon
				{viewon		"foresight3"}
			}
			{hide_crosshair}
			{weapon_sway_active}
		}
	}
)
