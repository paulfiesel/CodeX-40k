{from "pattern bullet"
	{tag "weapon smg 9mm_shell bullet to_hand auto_eject shoot_walking_manual -shoot_walking"}
	{inventory
		{size 5 2}
		{link_bone "gun_back"}
		{weight 100 }
	}

	{cursor "ironsights/smg"}

	{range 80 100}

	{curve "bullet_smg"}

	{LockFireDistanceTime 0.4}
	{foresight "Foresight11"}
	{SpreadTolerance 0.3}			;// AI needs to aim 30%
	{aimingTolerance 10} 
	{traceFreq 3}
	{Automatic}

	("reload time" seconds(3.0))

	{spreading
		{BurstAccuracy 100 90 80 60 50}
		{SpreadXYRatio	0.85}
	}
	{FiringTimeout 1.5 0.75}

	("penetration" args 10)
	("armor health" damage(2))

	("accuracy_smg")
	("9x19_bullet_damage")
	("ap_slope_multiplier")

	{thirdpersonparams inherit "human default"}
	("recoil_smg_n")
	("sway_smg")
}