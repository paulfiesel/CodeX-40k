(include "\set\cod_firearms_accuracy.inc")

;/*=========================*/

(define "burst_short"
	{burst
		{short 3 1}			;// short burst shots on long distance, rand (+-)shots
		{long 8 2}				;// long burst shots on short distance, rand (+-)shots
		{rangeKoef 0.5}			;// rangeKoef * aimRange = max long burst distance
	}
)

(define "burst_medium"
	{burst
		{short 4 1}
		{long 10 3}
		{rangeKoef 0.5}
	}
)

(define "burst_long"
	{burst
		{short 5 1}
		{long 12 3}
		{rangeKoef 0.5}
	}
)

(define "burst_stand"
	{burst
		{short 10 3}
		{long 20 3}
		{rangeKoef 0.75}
	}
)

(define "burst_aa"
	{burst
		{short 12 0}
		{long 25 3}
		{rangeKoef 0.5}
	}
)

(define "burst_aa_quad"
	{burst
		{short 30 0}
		{long 150 3}
		{rangeKoef 0.5}
	}
)

