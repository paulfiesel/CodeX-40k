
(include "\set\cod_firearms_accuracy.inc")

(define "battle_rifle"
	{tag "autorifle_sup auto_eject rifle_shell"}
	{range 130 130}
	{spreading
		{BurstAccuracy 100 90 80 60 50 40}
	}
	{burst
		{short 2 1}		; burst shots on long distance, rand (+-)shots
		{long 6 1}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.3}		; rangeKoef * aimRange = max long burst distance
	}
	{Automatic}
	("accuracy_rifle_auto")
	{LockFireDistanceTime 0.2}
	{SyncedProjectiles 0}		;// not for automatic weapons
	{FiringTimeout 1.5 0.5}
	{curve "autorifle"}
	{AccuracyByMotionK 1.2}
)
(define "semi_rifle"
	{tag "auto_eject semi_auto"}
	{range 135 135}
	{spreading 
		{BurstAccuracy 100 95 90 85 80 70 60}
	}
	{burst
		{short 1 0.5}		; burst shots on long distance, rand (+-)shots
		{long 3 1}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.2}	; rangeKoef * aimRange = max long burst distance
	}
	{LockFireDistanceTime 0.25}
	("fire rate" rpm(175))
	{FiringTimeout 2 0.75}
	{curve "autorifle"}
	{AccuracyByMotionK 1.2}
)
(define "assault_rifle" ;small size rifle calibers with full auto capability; stg44
	{tag "autorifle_sup auto_eject"}
	{range 130 130}
	{spreading
		{BurstAccuracy 100 95 90 85 80 75 70 65 60}
		{SpreadXYRatio	0.95}
	}

	{Automatic}
	{LockFireDistanceTime 0.5}
	{SyncedProjectiles 0}		;// not for automatic weapons
	{FiringTimeout 1.5 0.25}
	{burst
		{short 2.5 0.5}		; burst shots on long distance, rand (+-)shots
		{long 5.5 1.5}			; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.5}	; rangeKoef * aimRange = max long burst distance
	}
	{curve "assaultrifle"}
)

(define "bolt_action"
	{tag "bolt_action"}
	{range 120 120}
	;{Automatic}
	("fire rate" rpm(40)) 
	{states
		{reload		"reload"}
		{unload		"unload"}
		{fire		"fire"}
		{aim 		"aim"}
		{can_aim		"can-aim-bolt"}
	}
	{burst
		{short 0 0.1}	; burst shots on long distance, rand (+-)shots
		{long 2 0.1}	; burst shots on short distance, rand (+-)shots
		{rangeKoef 0.2}	; rangeKoef * aimRange = max long burst distance
	}
	{AccuracyByMotionK 1.2}
)

(define "zeroing_boost"
	{ZeroingAccuracy 0.95 0.9 0.85 0.825 0.8 0.775 0.75 0.725 0.7}
)


