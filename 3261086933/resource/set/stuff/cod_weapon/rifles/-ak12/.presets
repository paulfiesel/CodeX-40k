(define "marksman"
	{range 130 130}
	{ZeroingAccuracy 0.9 0.85 0.8 0.75 0.7 0.65 0.6}
	("human health" damage(80))
	("armor health" damage(35))
	("fire rate" rpm(50))
)

(define "k98_rate"
	{FiringTimeout 3.5 0.5}
	("fire rate" rpm(40))
)

(define "finnish_rate"
	{FiringTimeout 3.5 0.5}
	("fire rate" rpm(60))
)

(define "mosin_rate"
	{FiringTimeout 4 0.5}
	("fire rate" rpm(30))
)

(define "type53_rate"
	{FiringTimeout 3.5 0.5}
	("fire rate" rpm(40))
)

(define "bolt_action"
	{tag "bolt_action rifle_shell"}
	("marksman")
	{states
		{reload		"reload"}
		{unload		"unload"}
		{fire		"fire"	}
		{aim 		"aim"	}
		{can_aim	"can-aim-bolt"}
	}
)

(define "zeroing_boost"
	{ZeroingAccuracy 0.975 0.95 0.925 0.9 0.875 0.85 0.825 0.8}
)



(define "zoom_ak47"
	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.25"}
			;{offset		0 12 4.5}
			{offset		39.6 1.5 0.7	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 0}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			{no_grain}
			{no_rim_light}
		}
		{level 2
			{camera "human_zoom1.5"}
			{scope_vignette "/texture/common/environment/lens_effects/zoom_vignette_infantry_ak47"}
			{blur_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{bump_spec_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_ak47"}
			{vignette_gloss 15}
			{offset		2.5 2.25 0.75	}
			{hide_weapon 1}
			{with_owner
				{viewoff 	"fps_arms"	}
			}
			{with_weapon
				{viewon		"foresight3"}
			}
			{hide_crosshair}
			{weapon_sway_active}
		}
	}
)

