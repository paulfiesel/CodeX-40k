{from "pattern bullet"
	{tag "weapon rifle silenced hmg_shell rifle_slap_melee bullet to_hand mountable shoot_walking_manual -shoot_walking"}
	{inventory
		{size 6 2}
		{link_bone "gun_back"}
		{weight 100}
	}

	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}

	{curve "bullet"}

	{foresight "foresight12"}
	{RelaxationTime 0.5}
	{SpreadTolerance 0.05}			;// AI needs to aim 5%
	{aimingTolerance 12}			;// temp shoot on the move fix

	("reload time" seconds(6))
	("fire rate" rpm(30))

	("12_7x55_bullet_damage") 
	("ap_12_slope_multiplier")
	("sway_rifle")
	("accuracy_rifle")

	{thirdpersonparams inherit "human default"}
	{SyncedProjectiles 1} 			;// visually syncs decal/crater spawn in multiplayer
}