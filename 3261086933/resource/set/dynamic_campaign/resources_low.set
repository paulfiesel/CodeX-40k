{Low
	{GlobalMaxCP 600}
	{StageCP 80 90 110 130 150}
	{SpecialCP 100}					;// airstrikes special tab
	{EmplacementCP 50}				;// buildable with engineer
	{Bots
		{StartMP	1.0 min 350 attackerMultiplier 1.2}
		{FinishMP	1.5 min 400  attackerMultiplier 1.2}
		{CP
			{Base "0:50"} ;// seconds : CP
			{RoundMultiplier "0:0.3 2:0.4 4:0.5 6:0.6 8:0.7 12:0.8 14:1.0"} ;// games played : multiplier for CP
			{AttackMultiplier 100}
		}
		{DefenseLevel	
			{level_1
				{DefenseBudgetPlayer	0.5}
				{DefenseBudgetAI		0.5}
				{unlock games 0 progress 0.0}
			}
			{level_2
				{DefenseBudgetPlayer	0.75}
				{DefenseBudgetAI		0.75}
				{unlock games 6 progress 0.4}
			}
			{level_3
				{DefenseBudgetPlayer	1.0}
				{DefenseBudgetAI		1.0}
				{unlock games 12 progress 0.6}
			}
		}
	}
	{PaybackFactor 0.3}		;// MP paid back when loosing solider, squad or vehicle
	{SellFactor 0.5}
	{ScavengedVehicleSellFactor 0.5}		;// captured enemy vehicle 
	{RiskFactor
		{Low
			{BotResources 1.0}
			{BotVeterancy 0}
			{Rewards 1.0}
		}
		{Standard
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.25}
		}
		{High
			{BotResources 1.0}
			{BotVeterancy 3}
			{Rewards 1.5}
		}
	}
	{Resources
			{MP ;// Manpower (generic money)
				{StartVal 1250}
				{WinGain "1:400 4:450 6:500 8:750 10:800 12:850 14:1000"} ;// games played : MP gain 
				{LoseGain "1:250"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	700}
					{Ammodepot	700}
					{Bonus		1050}
					{Factory	750}
					{Research	750}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 15}
				{WinGain "1:5"}
				{LoseGain "1:0"}
				{MapRewards
					{Airfield	5}
				}
			}
			{AP ;// Ammo points
				{StartVal 2000}
				{WinGain "5:1300 10:1400 15:1600"}
				{LoseGain "1:500"}
				{MapRewards
					{Ammodepot	800}
					{Factory	500}
				}
			}
			{RP ;// Research points
				{StartVal 6}
				{WinGain "1:4 5:6 10:8"}
				{LoseGain 2}
				{MapRewards
					{Bonus		3}
					{Research	3}
				}
			}
			{Budget
				{Start "0:100 4:110 8:120 12:130 16:140 20:150"} ;// games played : starting CP of each match 
				{PointsPerSecond 0.20} ;// CP income
				{Limit 500} ;// Max CP 
			}
	}
	{ResupplyCost
		{Human
			{NewItem 0.8 AP}
			{Weight 0.7 AP}
			{Mechanic 0.2 AP}
		}
		{Vehicles
			{Weight 0.3 AP}
			{Fuel 0.2 AP}
			{Resupply 0.1 AP}
			{BrokenComponent
				{body 20 % MP 1 % AP}
				{turret 20 % MP 1 % AP}
				{engine 20 % MP 1 % AP}
				{track 10 % MP 1 % AP}
				{shield 1 % MP 1 % AP}
				{other 2 % MP 1 % AP} ;// If none of the above. Required.
			}
		}
		{Support
			{Airstrikes 100 % SP}
		}
	}
}