(define "multi_barrel_loop"
	{on "init_gun"
		{add_view "%flash"		"flashbarrel00"	"shooter00"}
		{add_view "%flash"		"flashbarrel01"	"shooter01"}
		{add_view "%flash"		"flashbarrel02"	"shooter02"}
		{add_view "%flash"		"flashbarrel03"	"shooter03"}
		{add_view "%flash"		"flashbarrel04"	"shooter04"}
		{add_view "%flash"		"flashbarrel05"	"shooter05"}
		{add_view "%flash"		"flashbarrel06"	"shooter06"}
		{add_view "%flash"		"flashbarrel07"	"shooter07"}
		{add_view "%smoke"		"smoke00"		"FXshell1"}
		{add_view "%smoke"		"smoke01"		"FXshell2"}
		{add_view "%smoke"		"smoke02"		"FXshell3"}
		{add_view "%smoke"		"smoke03"		"FXshell4"}
		{add_view "%smoke"		"smoke04"		"FXshell5"}
		{add_view "%smoke"		"smoke05"		"FXshell6"}
		{add_view "%smoke"		"smoke06"		"FXshell7"}
		{add_view "%smoke"		"smoke07"		"FXshell8"}
		{add_view "%shell"		"shell00"		"FXshell1"}
		{add_view "%shell"		"shell01"		"FXshell2"}
		{add_view "%shell"		"shell02"		"FXshell3"}
		{add_view "%shell"		"shell03"		"FXshell4"}
		{add_view "%shell"		"shell04"		"FXshell5"}
		{add_view "%shell"		"shell05"		"FXshell6"}
		{add_view "%shell"		"shell06"		"FXshell7"}
		{add_view "%shell"		"shell07"		"FXshell8"}

		{link_sound "rotate_turret" 	"vehicle/turret/gun/gun_horizontal"}
		{link_sound "rotate_gun" 		"vehicle/turret/gun/gun_vertical"}
		{call "update_gun"}
	}

	{on fire "%weapon" overload
		{delay 0.01
			{play_sound "action_recoil"}
		}
		{if tagged "firing"
			{call "play_shoot_loop"}
		else
			{call "play_shoot_loop"}
			{tags add "looping"}
		}
		{tags add "firing"}
		{delay %head
			{tags remove "firing"}
			{tags remove "looping"}
			{play_sound "tail_close"}
			{play_sound "tail_mid"}
			{play_sound "tail_far"}
			{delay 0.005
				{stop_sound "head_loop_close"}
				{stop_sound "head_loop_mid"}
				{stop_sound "head_loop_far"}
			}
		}
		(define "fire_barrel"
			name "%0"
				{call "fire_barrel%0"}
				{view show "flashbarrel%0"}
				{view start "flashbarrel%0"}
				{ani_play "fire%0"}
				{view start "shell%0"}
				{view start "smoke%0"}
				{delay 0.12 "shell_off"
					{view pause "shell%0"}
					{view pause "smoke%0"}
				}
				{delay 0.2 "fire"
					{view hide	"flashbarrel%0"}
					{view pause	"flashbarrel%0"}
				}
		)
		{if	("fire_barrel" args 00)
		else ("fire_barrel" args 01)
		else ("fire_barrel" args 02)
		else ("fire_barrel" args 03)
		else ("fire_barrel" args 04)
		else ("fire_barrel" args 05)
		else ("fire_barrel" args 06)
		else ("fire_barrel" args 07)
		}
	}
	{on "play_shoot_loop"
		{if tagged "looping"
			{play_sound "head_loop_close" 1}
			{play_sound "head_loop_mid" 1}
			{play_sound "head_loop_far" 1}
			{tags remove "looping"}
		}
	}
)

