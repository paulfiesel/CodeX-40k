;SDL
actor

(include "vehicle.ext")
(include "abm.inc")
(include "armor.ext")
(include "mobility.inc")

{PatherID "cannon.strecher"}
{collider "airborne"}
{constrain ground}
{lodclass "vehicle_plane"}

{TargetClass "airborne_uav"}
{targetSelector "airborne_bullet"}


{props "fpv" "engine"}
{compoundobstacles}

;{brain "vehicle" {state "vehicle"}}
("brain_vehicle")

{simulatorId "airborne"}
{simulation {able 1} {state 0}}

{RimLight}

{sensor
	{visor "main"
		{vision "none"}
	}
	{visor "hearing"
		{vision "none"}
	}
	{RecognizeTime 0.01}
	{InformRange 75 100}
}

{placer
	{crew 0}
	{place "driver" remove}
}

(define "air_movement"
	{dontUseSlope}
	{IgnorePatherBoundsAI}
	{disableBackward}
)

{Chassis "wheel"
	{locomotion
		{MaxSpeed		40	}	;// max speed while in wheeled mode in kph
		{maxSpeedAtMaxTurn 15}	;// max speed when at max turn in kph
		{TurnRadius		10	}	;// radius to do a 360?turn in meters
		{StartTime		20	}	;// time to accelerate to max speed from 0 kph in seconds
		{BrakeTime		2.5	}	;// time to decelerate from max speed to 0 kph in seconds when using brakes (hard stop)
		{StopTime		4	}	;// time to decelerate from max speed to 0 kph in seconds when coasting to a stop (not applying forward motion)
		{SteerOn		15	}	;// wheel turn speed in degrees per second
		{SteerOff		40	}	;// wheel stop turn speed in degrees per second
		{SplineRadius 	10	}	;// limit turning radius on the splines (path planner parameter), meters
	}
	{FuelBag
		{volume 500	}			;// maximum capacity of fuel tank in liters
		{rate	10	}			;// how much fuel is consumed during movement
		{remain 500	}			;// how much fuel is in fuel tank at spawn
		{fuel "fuel"}			;// type of fuel used. "fuel" = petrol/gasoline. "diesel" = diesel
	}
	{speed
		{Slow	10	}			;// speed for slow movement state
		{Normal	15	}			;// speed for normal movement state (single mouse click move order)
		{Fast	20	}			;// speed for fast movement state (double mouse click move order)
	}
	("air_movement")
}

{Chassis "helicopter"
	{locomotion
		{StartTime		3	}	; acceleration time from 0 to max. speed, seconds
		{BrakeTime		3	}	; deceleration time from max. speed, seconds - higher values than 1 can lead to helicopters not being able to stop before collision with an obstacle
		{StopTime		4	}	; stop time after turning off the engine from max. speed to 0, seconds but less
		{SplineRadius		5	}	; limit turning radius on the splines, meters
		{Slow			60	}	; km/h
		{Normal			80	}
		{Fast			100	}
		{MaxSpeed		60	}	; max speed, km/h
		{TurnRadius		15	}	; turn radius, m
	}
	{FrontSlopeSpeed		5	} ; degree/s
	{MaxFrontSlope			15	} ; degree
	{SideSlopeSpeed			25	} ; degree/s
	{MaxSideSlope			25	} ; degree
	{MaxElevationSpeed		5	} ; m/s
	{ElevationAcceleration	3	} ; m/s^2
	{MaxAltitude			50	} ; m
	{TravelAltitude			22	} ; m minimum altitude above ground, moving is dynamic
	{EngineStartupTime		3} ; seconds
	{DontUseSlope}
	{Airborne}
	;{IgnorePatherBoundsAI}		; AI ignores pather bounds, USER is constrained by pather bounds
	{FuelBag
		{volume	200}
		{rate  	 10 }			;// how much fuel is consumed during movemen
		{remain	200}
		{fuel "fuel"}
	}
}


{chassisManager
	{current "helicopter"}
}

{extender "inventory"
	{box
		{Size 3 5}
		{weight 200}
	}
}

{hearingBias 10.0}				;// reduces units ability to hear sound signals. value = meters

{Obstacle "in_air"
       	{Obb2
		{Center 0 0}
           		{Extent 0 0}
		{Axis -1 0}
       	 }
        	{rotate}
    }

{ObstacleId "helicopter" "in_air"}

(define "prop_blade"
	{volume "%number%volume"
		{tags "propeller" "still" "still%number"}
		{component "propeller%number"}
		{able clear {bullet} {blast} {touch} {contact} {NoWoundDecal}}
		{thickness 5}
	}
	{component "propeller%number"
		{RepairTime 10}
		{tags "propeller" "still" "still%number" "part"}
		{RepairOrder 10}
	}
)

(define "prop_spin"
	{volume "%volume%number"
		{tags "propeller" "spin" "spin%number"}
		{component "propeller%number"}
		{able clear {NoWoundDecal}}
		{thickness 5}
	}
	{component "%volume%number"
		{RepairTime 10}
		{tags "propeller" "spin" "spin%number"}
		{RepairOrder 10}
	}
)

(define "engine"
	{volume "%volume%number"
		{tags "engine%number"}
		{component "%volume%number"}
		{able {visible 0}}
		{thickness 2}
	}
	{component "%volume%number"
		{RepairTime 8}
		{tags "engine%number"}
		{RepairOrder 3}
	}
)

(define "engine_part"
	{volume "%volume%number%part"
		{tags "engine%number"}
		{component "%volume%number"}
		{able {visible 0}}
		{thickness 2}
	}
	{component "%volume%number"
		{RepairTime 8}
		{tags "engine%number"}
		{RepairOrder 3}
	}
)

(define "single_engine"
	("prop_blade"	volume(blade1)	number(1))
	("prop_blade"	volume(blade2)	number(1))
	("prop_blade"	volume(blade3)	number(1))
	("prop_blade"	volume(blade4)	number(1))
	("prop_blade"	volume(blade5)	number(1))
	("prop_blade"	volume(blade6)	number(1))
	("prop_spin"	volume(spin)	number(1))

	("engine"		volume(engine)	number())
	("engine"		volume(engine)	number(1))
	("engine_part"	volume(engine)	number(1) part(1))
	("engine_part"	volume(engine)	number(1) part(2))
	("engine_part"	volume(engine)	number(1) part(3))
	("engine_part"	volume(engine)	number(1) part(4))
	("engine_part"	volume(engine)	number(1) part(5))
	("engine_part"	volume(engine)	number(1) part(6))
)


(define "internals"
	{volume "%0"
		{tags "%1" "no_target"}
		{able {Contact 0} {NoWoundDecal}}
		{thickness 2}
		{component "%0"}
	}
	{component "%0"
		{RepairTime 2}
		{tags "%1"}
		{RepairOrder 5}
	}
)

("internals" args ammo ammo)
("internals" args ammo1 ammo)
("internals" args ammo2 ammo)
("internals" args ammo3 ammo)
("internals" args ammo4 ammo)
("internals" args ammo5 ammo)
("internals" args ammo6 ammo)
("internals" args ammo7 ammo)
("internals" args ammo8 ammo)
("internals" args ammo9 ammo)
("internals" args ammo10 ammo)

{volume "body"
	{able clear {visible} {bullet} {select} {contact_ground} {touch} {contact} {blast}}
}

{volume "select"
	{able clear {select} {touch}}
	{density 0}
}


(define "visible"
	{volume "%volume%number"
		%extra
		{tags %tags}
		{able {visible 0} {blast 0}}
		{thickness %thickness}
	}
	{component "%volume"
		{RepairTime 20}
		{tags "%tags"}
		{RepairOrder 5}
	}
)

("visible" volume(body) number() tags() extra() thickness(4))
("visible" volume(body) number(1) tags() extra() thickness(4))
("visible" volume(body) number(2) tags() extra() thickness(4))
("visible" volume(body) number(3) tags() extra() thickness(4))
("visible" volume(body) number(4) tags() extra() thickness(4))

("visible" volume(turret) number() tags() extra() thickness(2))
("visible" volume(turret) number(1) tags() extra() thickness(2))
("visible" volume(turret) number(2) tags() extra() thickness(2))
("visible" volume(turret) number(3) tags() extra() thickness(2))
("visible" volume(turret) number(4) tags() extra() thickness(2))

("basic_armor" args 100)

(define "fpv_durability"
	{perks
		{component "body"
			{health
				{hp %body}
				{hp_broken (* %body 0.5)}
			}
			("global_damage_mod")
		}
		{component "turret"
			{health
				{hp %part}
				{hp_broken 1}
			}
			("global_damage_mod")
		}
		{component "engine"
			{health
				{hp %engine}
				{hp_broken (* %engine 1.33)}
			}
			("global_damage_mod")
		}
		{component "ammo"
			{health
				{hp %ammo}
				{hp_broken (* %ammo 1.1)}
			}
			("global_damage_mod")
		}
		{component tag "propeller"
			{health
				{hp %propeller}
				{hp_broken (* %propeller 1.0)}
			}
			("global_damage_mod")
		}
		{component tag "part"
			{health
				{hp %part}
				{hp_broken 1}
			}
			("global_damage_mod")
		}
	}
)

("fpv_durability" body(1) turret(1) engine(1) propeller(1) ammo(1) part(1))

{perks
	{blastwave_modifier 25}
}