;SDL
actor

(include "vehicle.ext")
(include "abm.inc")
(include "armor.ext") 
(include "mobility.inc")

{Collider "airborne"}
{lodclass "vehicle_plane"}

{PatherID "bf109"}

{Props "uav" "muzzle_zenite" "vision_lev01_uav"}
{compoundobstacles}

{TargetClass "airborne_uav"}
{targetSelector "airborne_bullet"}

{brain "vehicle" {state "airborne"}}

{SimulatorId "airborne"}
{ObstacleId "airborne" "in_air"}

{sensor
	{Visor "main"
		{vision "cover-detector"}
		{bone "visor"}
	}
}

{Placer
	{crew 0}
	{place "driver" remove}
}

{extender "inventory"
	{box
		{Size 0 0}
		{clear}
	}
}

{perks
	{component "body"
		{category "airborne_medium"}
	}
	{component "engine"
		{category "engine_medium"}
	}
	{blastwave_modifier 5.0}
}

{Chassis "wheel"
	{locomotion
		{MaxSpeed				2	}			;// max speed while in wheeled mode in kph
		{maxSpeedAtMaxTurn 			5	}			;// max speed when at max turn in kph
		{StartTime				2	}			;// time to accelerate to max speed from 0 kph in seconds
		{BrakeTime				1	}			;// time to decelerate from max speed to 0 kph in seconds when using brakes (hard stop)
		{StopTime				2	}			;// time to decelerate from max speed to 0 kph in seconds when coasting to a stop (not applying forward motion)
	}
	{FuelBag
		{volume					500	}			;// maximum capacity of fuel tank in liters
		{rate					10	}			;// how much fuel is consumed during movement
		{remain 					500	}			;// how much fuel is in fuel tank at spawn
		{fuel 					"fuel"	}			;// type of fuel used. "fuel" = petrol/gasoline. "diesel" = diesel
	}
	{speed
		{Slow					2	}			;// speed for slow movement state
		{Normal					5	}			;// speed for normal movement state (single mouse click move order)
		{Fast					9	}			;// speed for fast movement state (double mouse click move order)
	}
	{DontUseSlope}
}

{Chassis "helicopter"
	{FrontSlopeSpeed			5	} ; degree/s
	{MaxFrontSlope			15	} ; degree
	{SideSlopeSpeed			25	} ; degree/s
	{MaxSideSlope			25	} ; degree
	{MaxElevationSpeed		5	} ; m/s
	{ElevationAcceleration		3	} ; m/s^2
	{MaxAltitude			50	} ; m
	{TravelAltitude			22	} ; m minimum altitude above ground, moving is dynamic
	{EngineStartupTime		3	} ; seconds

	{DontUseSlope}
	{Airborne}
	{IgnorePatherBoundsAI}		; AI ignores pather bounds, USER is constrained by pather bounds
	{FuelBag
		{volume 1000}
		{rate   10}			;// how much fuel is consumed during movemen
		{remain 1000}
		{fuel "fuel"}
	}
	{dontUseSlope}
	{IgnorePatherBoundsAI}
}

{ChassisManager
	{Current "helicopter"}
}

(define "uav_model"
	{locomotion
		{StartTime		3	}	; acceleration time from 0 to max. speed, seconds
		{BrakeTime		3	}	; deceleration time from max. speed, seconds - higher values than 1 can lead to helicopters not being able to stop before collision with an obstacle
		{StopTime		4	}	; stop time after turning off the engine from max. speed to 0, seconds but less
		{SplineRadius		5	}	; limit turning radius on the splines, meters
		{Slow			30	}	; km/h
		{Normal			40	}
		{Fast			60	}
		{MaxSpeed		60	}	; max speed, km/h
		{TurnRadius		15	}	; turn radius, m
	}
	{FuelBag
		{volume %fuel}						;// Fuel capacity in Liters.
		{rate (* 20 (/ %fuel %range))}					;// Fuel consumption rate. Based on off-road range of vehicle.
		{remain %fuel}						;// Amount of fuel in vehicle when spawned.
		{fuel "fuel"}						;// Type of fuel used. "fuel" = petrol/gasoline. "diesel" = diesel.
	}

)

(define "engine"
	{volume "%volume%number"
		{tags "engine%number"}
		{component "%volume%number"}
		{able {visible 0}}
		{thickness 1.2}
	}
	{component "%volume%number"
		{RepairTime 20}
		{tags "engine%number"}
		{RepairOrder 3}
	}
)

(define "propeller"
	{volume "%volume%number"
		{component "propeller"}
		{tags "propeller"}
		{thickness 5}
	}
	{component "%volume%number"
		{RepairTime 30}
		{RepairOrder 3}
	}
)

(define "blade"
	{volume "%volume%number"
		{component "blade%number"}
		{tags "blade"}
		{able clear {bullet} {blast} {touch} {contact} {NoWoundDecal}}
		{thickness 1.5}
	}
	{component "%volume%number"
		{RepairTime 12}
		{tags "blade"}
		{RepairOrder 3}
	}
)
(define "rotor"
	{volume "%volume%number"
		{component "rotor%number"}
		{tags "rotor"}
		{able clear {bullet} {blast} {touch} {contact} {NoWoundDecal}}
		{thickness 5}
	}
	{component "%volume%number"
		{RepairTime 12}
		{tags "rotor"}
		{RepairOrder 3}
	}
)

(define "bladex4"
	("blade"		volume(blade)	number(1))
	("blade"		volume(blade)	number(2))
	("blade"		volume(blade)	number(3))
	("blade"		volume(blade)	number(4))
)

("engine"		volume(engine)	number())


(define "uav_durability"
	{perks
		{component "body"
			{health
				{hp %body}
				{hp_broken (* %body 0.5)}
			}
			("global_damage_mod")
		}
		{component "engine"
			{health
				{hp %engine}
				{hp_broken (* %engine 1.33)}
			}
			("global_damage_mod")
		}
		{component tag "propeller"
			{health
				{hp %propeller}
				{hp_broken (* %propeller 1.0)}
			}
			("global_damage_mod")
		}
		{component tag "blade"
			{health
				{hp %blade}
				{hp_broken (* %blade 0.75)}
			}
			("global_damage_mod")
		}
		{component tag "rotor"
			{health
				{hp %rotor}
				{hp_broken (* %rotor 0.75)}
			}
			("global_damage_mod")
		}
	}
)

;/*=============== Tearable End ===============*/

("basic_armor" args 99)

("body" repair(40))

("uav_durability" body(100) engine(50) propeller(50) blade(25) rotor(25))

{perks
	{blastwave_modifier 7.5}
}
