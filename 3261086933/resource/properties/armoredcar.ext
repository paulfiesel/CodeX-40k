;SDL
actor

(include "vehicle.ext")
(include "car_crew.ext")
(include "armor.ext")
(include "abm.inc")
(include "mobility.inc")

("brain_vehicle")

{PatherID  "armored"}
{collider "armored"}

{props "armored_car_M" "engine" "hatch" "detect_tank_light" "antifire" "standart_netting"}

{targetClass "armoredcar" "bullet"}
{targetSelector "tank_light"}

{hearingBias 4.5}				;// reduces units ability to hear sound signals. value = meters

{sensor
	{visor "main"
		;{vision "tank_range_200"}
		;{bone "foresight1"}
		{bone "visor1"}
	}
	{Visor "driver"
		{vision "tank_driver"}
		{bone "visor2"}
	}
	;{visor "around"
	;	{vision "vehicle_around"}
	;	{bone "visor1"}
	;}
	;{visor "human"
	;	{vision "human"}
	;	{bone "visor3"}
	;}

	(mod "mp"	
		{visor "view-around"	
			{vision "tank_around-l"}
			{bone "visor2"}	
		}	
	)
	;{visor "none"
	;	{vision "none"}
	;}
	{Visor "hearing"
		{vision "noise_detection"}
		{bone "hearing_bone"}
	}
}

{Skeleton
	{bone "hearing_bone"
		{Position 0 0 50}
	}
}

{extender "inventory"
	{box
		{Size 9 16}
		;{Weight 10000}
		{Weight 2000}
		{item "can" 1}
		{item "repair_kit" 10}
		{item "fire_extinguisher" 3}
		{item "netting_kit" 5}
		{item "grenade nbk39" 6}		
	}
}

{extender "talk"
	{talker "tank"}
}
{able "talk"}

(define "restore_ik_time"
	{RestoreIKTime 10}
)

("basic_armor" args 10)

("general_durability" body(200) engine(125) turret(100) mantlet(125) gun(100) track(100) ammo(120))

{perks {blastwave_modifier 10.0}}

("body"	repair(100))
("engine" repair(45))

{Volume "tank_crit_component"
		{box 10 10 10}
		{Bone "basis"}
		{Position 28 0 18}
							
}


{Volume "panel_engine_connector"
		{box 6 6 6}
		{Bone "basis"}
		{Position -15 10 18}
							
}

{volume "tank_crit_component" {thickness 20} {component "tank_crit_component"}}
{component "tank_crit_component" {RepairTime 5}  {RepairOrder 2}}	


{volume "panel_engine_connector" {thickness 20} {component "panel_engine_connector"}}
{component "panel_engine_connector" {RepairTime 5}  {RepairOrder 2}}	


(define "armor_turret_ring"
	{volume "%volume" {thickness %thickness}}
	{armor
		{setting "%volume"
			{thickness %thickness %thickness %thickness 1}		
			{durability {blast {value 50}} {pierce {koef 999}}}
			{threshold {blast {koef 2} {value 50}}}
			{volumes "%volume*"}
		}
	}

)

(define "armor_btr"		;for IFV-level armor about 25mm - Bradly, BMP-1,2,3, M113.
    ;("armor_tank" t(20) track_b(10) bod(%body) tur(%turret) en(12) gun(15) stab(25) dur(1) thr(1) pierce_dur(999) dur_value(12) thr_value(10))
	("armor_tank" t(20) track_b(10) bod(%body) tur(%turret) en(12) gun(15) stab(12) dur(1) thr(1) pierce_dur(999) dur_value(20) thr_value(7))
    ("components_tank" repair(1.5))
	{sensor
		{visor "main"
			{vision "tank_main-l"}
		}
	}

)

{placer
	{place "black_target_hold"
		{entity "black_target_holder"}
		{linkbone "missile_aim_point_bone"}
		{turnOff {targetable}{sensor}{shadow}}
		{openForCrush}
		{obstacle disable}
	}
}