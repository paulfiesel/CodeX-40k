msgid "<c(ff8c00)>ERA Pierced!"
msgstr "<c(ff8c00)>反应装甲触发!"

msgctxt "component/apu_damaged"
msgid "<c(ff8c00)>APU Damaged!"
msgstr "<c(ff8c00)>辅助动力系统受损!"

msgctxt "component/zpu_disabled"
msgid "<c(ff8c00)>AAMG Always Disabled"
msgstr "<c(ff8c00)>防空机枪：关闭"

msgctxt "component/zpu_enabled"
msgid "<c(ff8c00)>AAMG Always Enabled"
msgstr "<c(ff8c00)>防空机枪：开启"

msgctxt "component/zpu_careful"
msgid "<c(ff8c00)>AAMG Dynamic"
msgstr "<c(ff8c00)>动态防空机枪开关"

msgctxt "component/suspension_active"
msgid "<c(ff8c00)>Suspension State: Low."
msgstr "<c(ff8c00)>悬挂状态: 低."

msgctxt "component/suspension_deactive"
msgid "<c(ff8c00)>Suspension State: Normal."
msgstr "<c(ff8c00)>悬挂状态: 正常."

msgctxt "actionbar/specability"
msgid "Toggle to drop the vehicle"
msgstr "丢下载具开关"

msgctxt "actionbar/specability/action"
msgid "Click the button to paradrop the armored vehicle"
msgstr "点击按钮空投装甲载具"

msgctxt "component/antifire"
msgid "<c(ff8c00)>Fire extinguished!"
msgstr "<c(ff8c00)>火以扑灭！"

msgctxt "actionbar/vehicle/fire_extinguisher"
msgid "Click the button to extinguish the fire"
msgstr "点击按钮来灭火"

