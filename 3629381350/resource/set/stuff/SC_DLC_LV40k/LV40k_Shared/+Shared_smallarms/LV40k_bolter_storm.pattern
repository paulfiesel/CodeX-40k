
; ======== Just a bolter with a higher ROF and more spreading - Less damage for balance

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Heavy_Machine_Gun")
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(LV40k_weapon lv40k_bolter_storm)
		animationType(mgun)
		
		invSize(8 3)
		weight(36.5)	
		
		calibre(19.7)
		aimbone(foresight3)
		curve(bullet_bolter) 
		
		reloadSpeed(9.0)
		fireRate(500)	
		projectileSpeed(500)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T7)		; 	<- has more piercing with regular rounds.
		healthDamage(800)				;

		minRange(140)	maxRange(140)
	)
	{parameters "kraken"
		("SC_Weapon_Smallarms"
			weaponCategory(mgun)
			weaponTag(LV40k_weapon lv40k_bolter_storm)
			animationType(mgun)
			
			invSize(8 3)
			weight(36.5)	
			
			calibre(19.7)
			aimbone(foresight3)
			curve(bullet_bolter) 
			
			reloadSpeed(9.0)
			fireRate(500)	
			projectileSpeed(500)
			
			; see on SC_weapons
			recoilStrenght(Extreme)	
			fireMode(Auto_v6)
			
			armorPiercing(Smallarms_T10)		
			healthDamage(1200)				

			minRange(140)	maxRange(140)
		)
	}
}
