{from "pattern bullet"
	{cursor "ironsights/tank"}				;// rts cursor
	{cursorReloading "gun_ic"}				;// rts reload cursor
	
	{gravity 0}
	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- force pistol FSM
		weaponTag(LV40k_weapon)
		animationType(pistol)		; <- force pistol FSM
		
		invSize(6 2)
		weight(5.0)
		
		calibre(0)
		aimbone(foresight3)
		curve() 
		
		reloadSpeed(5.0)
		fireRate(100)	
		projectileSpeed(200)
		
		; see on SC_weapons
		recoilStrenght(Medium)	
		fireMode(Semi_v1)
		
		armorPiercing(None)
		healthDamage(0)	
		
		minRange(100)	maxRange(100)
	)
}
