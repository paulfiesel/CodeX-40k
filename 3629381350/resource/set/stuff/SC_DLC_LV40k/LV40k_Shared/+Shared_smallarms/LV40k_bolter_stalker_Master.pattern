
; Has more range, does incredible damage, has less ROF, Longer Reload

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Bolter")
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(LV40k_weapon lv40k_bolter_stalker)
		animationType(mgun)
		
		invSize(6 2)
		weight(19)	
		
		calibre(19.7)
		aimbone(foresight3)
		curve(bullet_bolter) 
		
		reloadSpeed(6.0)
		fireRate(65)	
		projectileSpeed(500)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Auto_v4)
		
		armorPiercing(Smallarms_T7)
		healthDamage(3000)

		minRange(160)	maxRange(160)
	)
	{parameters "kraken"
		("SC_Weapon_Smallarms"
			weaponCategory(mgun)
			weaponTag(LV40k_weapon lv40k_bolter_stalker)
			animationType(mgun)
			
			invSize(6 2)
			weight(19)	
			
			calibre(19.7)
			aimbone(foresight3)
			curve(bullet_bolter) 
			
			reloadSpeed(6.0)
			fireRate(65)	
			projectileSpeed(500)
			
			; see on SC_weapons
			recoilStrenght(Extreme)	
			fireMode(Auto_v4)
			
			armorPiercing(Smallarms_T10)
			healthDamage(6000)

			minRange(160)	maxRange(160)
		)
	}
}
