{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Basic_Lasgun")
	{gravity 0.0} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(rifle)
		weaponTag(LV40k_weapon lv40k_lasgun_common)
		animationType(rifle)
		invSize(6 2)
		weight(2.3)		
		
		calibre(7.62)
		aimbone(foresight3)
		curve(bullet_lasgun_rifle) 
		
		reloadSpeed(4.0)
		
		fireRate(150)	; WAS 175
		
		projectileSpeed(700)
		
		; see on SC_weapons
		recoilStrenght(Heavy)	
		fireMode(Auto_v5)
		
		armorPiercing(Smallarms_T2)
		healthDamage(300)	
		
		minRange(100)	maxRange(100)
	)
	
	; // Super-Charged ammo for veterans - has more range, piercing, and fires faster
	
	{parameters "c1"
		("SC_Weapon_Smallarms"
			weaponCategory(rifle)
			weaponTag(LV40k_weapon lv40k_lasgun_common)
			animationType(rifle)
			invSize(6 2)
			weight(2.3)			
			
			calibre(7.62)
			aimbone(foresight3)
			curve(bullet_lasgun_rifle) 
			
			reloadSpeed(5.0)	; <- more recharge  time
			
			fireRate(225)
			
			projectileSpeed(700)
			
			; see on SC_weapons
			recoilStrenght(Heavy)	
			fireMode(Auto_v6)
			
			armorPiercing(Smallarms_T4)
			healthDamage(400)	
			
			minRange(120)	maxRange(120)
		)
	}
}
