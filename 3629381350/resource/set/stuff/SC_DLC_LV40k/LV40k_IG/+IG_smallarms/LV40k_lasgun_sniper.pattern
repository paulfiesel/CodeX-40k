{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Basic_Lasgun")
	{gravity 0.0} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(rifle)
		weaponTag(LV40k_weapon lv40k_lasgun_common)
		animationType(rifle)
		invSize(6 2)
		weight(2.3)			; not accurate!
		
		calibre(7.62) 		; generic calibre.
		aimbone(foresight3)
		curve(bullet_lasgun_rifle) 
		
		reloadSpeed(3.5)
		
		fireRate(185)	; WAS 200
		
		projectileSpeed(900)
		
		; see on SC_weapons
		recoilStrenght(Heavy)	
		fireMode(Auto_v5)
		
		armorPiercing(Smallarms_T5)
		healthDamage(500)	; <- LASGUNS DEAL ADDITIONAL DAMAGE IN INTERACTION ENTITY. 
		
		minRange(140)	maxRange(140)
	)
}
