		fireRate(2000)	
		projectileSpeed(500)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T9)
		healthDamage(600)
		
		minRange(160)	maxRange(160)
	)
}
