
; // Pretty much a super hellgun stat wise.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Basic_Lasgun")
	{gravity 0.0} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(rifle)
		weaponTag(LV40k_weapon lv40k_multilaser)
		animationType(rifle)
		invSize(8 3)
		
		weight(40.0)		; not accurate!
		calibre(11.76) 		; generic calibre.
		
		aimbone(foresight3)
		curve(bullet_lasgun_rifle) 
		
		reloadSpeed(7.6)
		fireRate(400)	
		
		projectileSpeed(600)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T7)
		healthDamage(240)
		
		minRange(140)	maxRange(140)
	)
}
