
; ======== Tank Gun - Gatling - Less damage and stopping power compared to punisher cannon.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Assault_Cannon")
	{Gravity 1.0} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(LV40k_weapon LV40k_gatling)
		animationType(mgun)
		invSize(6 2)
		
		weight(250)	
		
		calibre(30)		
		aimbone(foresight3)
		curve(bullet_bolter)	; <- TEMP CURVE 
		
		reloadSpeed(12)
		fireRate(1500)	
		projectileSpeed(500)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T7)
		healthDamage(450)
		
		minRange(140)	maxRange(140)
	)
}
