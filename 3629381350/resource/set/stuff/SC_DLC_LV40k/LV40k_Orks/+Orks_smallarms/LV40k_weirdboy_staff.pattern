{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{filling "weirdboy_ammo" 1}	
	
	("SC_Weapon_Accuracy_LV40k_Psyker_Wand")
	{gravity 0.44}	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)
		weaponTag(LV40k_weapon lv40k_weirdboy_staff)
		animationType(pistol)
		invSize(8 3)
		weight(10.0)		; <- not accurate			
		
		calibre(1) 			; <- irrelevant	
		aimbone(foresight3)
		curve(gun_std) 		; <- generic curve
		
		reloadSpeed(6.0)
		fireRate(10)	
		projectileSpeed(50)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Semi_v1)
		
		armorPiercing(Bazooka_T1)
		healthDamage(6000)	
		
		minRange(100)	maxRange(100)
	)
	{parameters "warpvomit"
		("SC_Weapon_Smallarms"
			weaponCategory(pistol)
			weaponTag(LV40k_weapon lv40k_weirdboy_staff)
			animationType(pistol)
			invSize(8 3)
			weight(10.0)		; <- not accurate			
			
			calibre(1) 			; <- irrelevant	
			aimbone(foresight3)
			curve(gun_std) 		; <- generic curve
			
			reloadSpeed(12.0)
			fireRate(10)	
			projectileSpeed(30)
			
			; see on SC_weapons
			recoilStrenght(Low)	
			fireMode(Semi_v1)
			
			armorPiercing(None)
			healthDamage(0)	
			
			minRange(80)	maxRange(80)
		)
	}
}
