
; // Vehicle Mounted - Has a bigger Boom - Deff Dread / Warbuggy / Looted Tank

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Rokkit_Launcha")
	{gravity 0.33} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun grenadelauncher)
		weaponTag(LV40k_weapon lv40k_rokkit_launcha)
		animationType(mgun)
		
		invSize(8 3)
		weight(20.0)		; <- not accurate			
		
		calibre(60) 		
		aimbone(foresight3)
		curve(gun_std) 		; <- generic curve
		
		reloadSpeed(8.0)
		fireRate(125)	
		projectileSpeed(75)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Auto_v1)
		
		armorPiercing(Bazooka_T3)
		healthDamage(16000)	
		
		minRange(100)	maxRange(100)
	)
}
