
; // Tyranid Autocannon

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Deathspitter")	
	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_warrior_w LV40k_tyr_ravener_w lv40k_tyr_deathspitter)

		invSize(8 3)
		weight(100)	
		
		calibre(10)	
		aimbone(foresight_tyr_deathspitter)
		curve(gun_std)
		
		reloadSpeed(5.0)
		fireRate(150)	
		
		projectileSpeed(150)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Auto_v1)
		
		armorPiercing(Smallarms_T9)
		healthDamage(1200)			
		
		minRange(120)	maxRange(120)
	)
	
	{inventory	{link_bone ""}}
}
