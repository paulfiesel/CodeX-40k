
; ======== Tyranid lascannon, less powerful but with fast fire-rate

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{tag "shoot_walking shoot_walking_ai"}
	
	("SC_Weapon_Accuracy_LV40k_Lascannon")
	{gravity 0.0} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(LV40k_weapon lv40k_tyr_shockcannon)
		animationType(mgun)
		
		invSize(8 3)
		weight(80)		
		
		calibre(100) 	; generic calibre.
		aimbone(foresight3)
		curve(gun_std)	; vanilla curve for cannons 
		
		reloadSpeed(8.0)
		fireRate(8.0)	
		projectileSpeed(800)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Semi_v2)
		
		armorPiercing(AT_T2)
		healthDamage(30000)	
		
		minRange(160)	maxRange(160)
	)
}
