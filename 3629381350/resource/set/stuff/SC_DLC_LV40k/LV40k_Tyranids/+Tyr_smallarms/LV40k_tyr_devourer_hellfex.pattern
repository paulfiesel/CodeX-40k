
; // Hellfex - Anti Infantry Carnifex

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{tag "shoot_walking shoot_walking_ai"}
	
	("SC_Weapon_Accuracy_LV40k_Deathspitter")
	{DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(LV40k_weapon lv40k_tyr_devourer)
		
		invSize(8 3)
		weight(100)	
		
		calibre(10)	
		aimbone(foresight_tyr_devourer)
		curve(gun_std)		; <- temp curve 
		
		reloadSpeed(12.5)
		fireRate(2000)	
		
		projectileSpeed(120)
		
		; see on SC_weapons
		recoilStrenght(High)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T6)
		healthDamage(500)				; <- most damage comes from afterdamage caused by devourer worms
		
		minRange(120)	maxRange(120)
	)
	
	{inventory	{link_bone ""}}
}
