
; // Short ranged dual-wielded SMG.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Spinefists")	
	{gravity 1.4}

	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_gaunt_w lv40k_tyr_spinefists)
		
		invSize(4 2)
		weight(100)	
		
		calibre(10)	
		aimbone(foresight_tyr_spinefists)
		curve(gun_std)		; <- temp curve 
		
		reloadSpeed(3.0)
		fireRate(400)	
		
		projectileSpeed(200)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v3)
		
		armorPiercing(Smallarms_T4)
		healthDamage(300)		 
		
		minRange(80)	maxRange(80)
	)
	
	{inventory	{link_bone ""}}
}
