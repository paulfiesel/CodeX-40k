
; // Ravener Devourer - Shoots faster.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Devourer")	
	{DisableRicochet}
	{Gravity 2.5}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_ravener_w lv40k_tyr_devourer_ravener)
		invSize(8 3)
		
		weight(100)	
		calibre(10)	
		
		aimbone(foresight_tyr_devourer)
		
		curve(gun_std)		; <- temp curve 
		
		reloadSpeed(4.8)
		fireRate(600)	
		
		projectileSpeed(150)
		
		; see on SC_weapons
		recoilStrenght(High)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T5)
		healthDamage(300)				; <- most damage comes from afterdamage caused by devourer worms
		
		minRange(100)	maxRange(100)
	)
	
	{inventory	{link_bone ""}}
}
