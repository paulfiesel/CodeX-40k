
; // Basic Strangler carried by Warriors.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Barbed_Strangler")
	{gravity 1.5} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_warrior_w lv40k_tyr_barbed_strangler)
		shoot_walking(Cannot)
		
		invSize(8 3)
		weight(100.0)	
		
		calibre(60) 	
		aimbone(foresight_tyr_barbed_strangler)
		curve(gun_std) 		
		
		reloadSpeed(5.0)
		fireRate(10)	
		projectileSpeed(40)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Semi_v1)
		
		armorPiercing(Bazooka_T1)
		healthDamage(15000)	
		
		minRange(80)	maxRange(80)		
	)
	
	{inventory	{link_bone ""}}
}
	
