		calibre(10)	
		aimbone(foresight3)	
		curve(gun_std)		; <- temp curve 
		
		reloadSpeed(3.0)
		fireRate(1600)	
		
		projectileSpeed(75)
		
		; see on SC_weapons
		recoilStrenght(High)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T8)
		healthDamage(800)		
		
		minRange(80)	maxRange(80)
	)
	
	{inventory	{link_bone ""}}
}
