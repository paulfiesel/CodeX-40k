	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{tag "shoot_walking shoot_walking_ai"}
	
	("SC_Weapon_Accuracy_LV40k_Deathspitter")	; <- Temp!
	{gravity 4.5}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		
		animationType(anm_pistol)
		weaponTag(LV40k_weapon lv40k_tyr_stingers)
		
		invSize(8 3)
