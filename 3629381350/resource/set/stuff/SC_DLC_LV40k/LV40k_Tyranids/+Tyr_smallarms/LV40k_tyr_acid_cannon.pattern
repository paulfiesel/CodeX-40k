
; // Acid cannon that works like a tyranid version of the multi-melta

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{tag "shoot_walking shoot_walking_ai"}
	
	("SC_Weapon_Accuracy_LV40k_Melta")	; <- mirrors meltagun	
	{gravity 2.0} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(LV40k_weapon lv40k_tyr_acid_cannon)
		animationType(mgun)
		
		invSize(8 3)
		weight(100.0)				
		
		calibre(100) 		; <- generic calibre
		aimbone(foresight3)
		curve(bullet_melta) ; <- mirrors meltagun
		
		reloadSpeed(16.0)
		fireRate(800)	
		projectileSpeed(225)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v6)
		
		armorPiercing(AT_T6)	; <- mirrors meltagun
		healthDamage(30000)	
		
		minRange(60)	maxRange(60)
	)
}
