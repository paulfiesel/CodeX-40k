
; // Basic Venom Cannon carried by Warriors.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Sniper")	
	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol sniper)		; <- must be classed as pistol
		animationType(anm_pistol)			; <- must be classed as pistol
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_warrior_w lv40k_tyr_venom_cannon)
		
		invSize(8 3)
		weight(100)	
		
		calibre(100)	
		aimbone(foresight_tyr_venom_cannon)
		curve(gun_std)
		
		reloadSpeed(6.0)
		fireRate(12)
		
		projectileSpeed(200)

		; see on SC_weapons
		recoilStrenght(Harsh)	
		fireMode(Semi_v2)
		
		armorPiercing(AT_T2)
		healthDamage(10000)		
		
		minRange(120)	maxRange(120)	
	)
	
	{inventory	{link_bone ""}}
}
