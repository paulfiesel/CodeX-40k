
; // Smoke Gas Launcher used by Venomthropes

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Barbed_Strangler")
	{gravity 0.8} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(LV40k_weapon LV40k_tyr_venomthrope_ww lv40k_tyr_venomthrope_s_w)
		
		invSize(8 3)
		weight(100.0)	
		
		calibre(60) 	
		aimbone(foresight_tyr_Toxic_Launcher)
		curve(gun_std) 		
		
		reloadSpeed(6.0)
		fireRate(6.5)	
		
		projectileSpeed(30)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Semi_v1)
		
		armorPiercing(Grenade_HE_T2)
		healthDamage(3000)	
		
		minRange(60)	maxRange(60)		
	)
	
	{inventory	{link_bone ""}}
}
	
