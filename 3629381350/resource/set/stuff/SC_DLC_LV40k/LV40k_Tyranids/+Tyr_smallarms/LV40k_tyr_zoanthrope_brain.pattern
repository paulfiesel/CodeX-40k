{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Basic_Lasgun")	; <- temp
	{gravity 0.0} {DisableRicochet}

	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_zoanthrope_w lv40k_tyr_zoanthrope_brain)
		
		invSize(8 3)
		weight(100)		
		
		calibre(60) 		
		aimbone(foresight_tyr_zoanthrope_brain)
		curve(gun_std) 
		
		reloadSpeed(7.0)
		
		fireRate(1200)	
		
		projectileSpeed(600)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Burst_x8)
		
		armorPiercing(Bazooka_T1)
		healthDamage(900)	
		
		minRange(100)	maxRange(100)
	)
	
	{inventory	{link_bone ""}}
}
