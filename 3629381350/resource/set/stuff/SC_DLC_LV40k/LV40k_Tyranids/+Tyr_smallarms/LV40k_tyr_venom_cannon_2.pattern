
; // Heavy Rapid-Fire version of Venom Cannon carried by Carnifex and Hive Tyrant. Has more range, damage and armor piercing.

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	{tag "shoot_walking shoot_walking_ai"}
	
	("SC_Weapon_Accuracy_LV40k_Venom_Cannon")	
	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		weaponTag(LV40k_weapon lv40k_tyr_venom_cannon)
		
		invSize(8 3)
		weight(100)	
		
		calibre(150)	
		aimbone(foresight_tyr_venom_cannon)
		curve(gun_std)
		
		reloadSpeed(12.5)
		fireRate(17.5)
		
		projectileSpeed(320)

		; see on SC_weapons
		recoilStrenght(Harsh)	
		fireMode(Semi_v3)
		
		armorPiercing(AT_T6)
		healthDamage(60000)		
		
		minRange(200)	maxRange(200)	
	)
}
