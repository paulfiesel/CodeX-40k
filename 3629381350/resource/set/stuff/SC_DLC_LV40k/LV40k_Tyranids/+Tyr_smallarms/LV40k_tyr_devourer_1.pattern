
; // Devourer carried by Warriors

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Devourer")	
	{gravity 2.5} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(pistol)		; <- must be classed as pistol
		animationType(anm_pistol)	; <- must be classed as pistol
		
		weaponTag(SC_hide_root LV40k_weapon LV40k_tyr_warrior_w LV40k_tyr_gaunt_w lv40k_tyr_devourer)
		invSize(8 3)
		
		weight(100)	
		calibre(10)	
		
		aimbone(foresight_tyr_devourer)
		
		curve(gun_std)		; <- temp curve 
		
		reloadSpeed(3.0)
		fireRate(300)	
		
		projectileSpeed(150)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v3)
		
		armorPiercing(Smallarms_T5)
		healthDamage(600)		; <- most damage comes from afterdamage caused by devourer worms
		
		minRange(100)	maxRange(100)
	)
	
	{inventory	{link_bone ""}}
}
