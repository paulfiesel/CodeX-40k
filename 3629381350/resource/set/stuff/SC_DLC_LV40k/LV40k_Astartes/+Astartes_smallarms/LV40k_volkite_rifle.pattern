{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Basic_Hellgun") ; <- temp		
	{gravity 0} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(rifle)
		weaponTag(SC_fire_loop LV40k_weapon lv40k_volkite_caliver)
		animationType(rifle)
		invSize(6 2)
		
		weight(20.0)		; not accurate!
		calibre(20) 		; generic calibre.
		
		aimbone(foresight3)
		curve(bullet_lasgun_rifle) ; <- TEMP!
		
		reloadSpeed(8.0)
		fireRate(700)	
		
		projectileSpeed(200)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v3)
		
		armorPiercing(Smallarms_T7)
		healthDamage(400)
		
		minRange(120)	maxRange(120)
	)
}
