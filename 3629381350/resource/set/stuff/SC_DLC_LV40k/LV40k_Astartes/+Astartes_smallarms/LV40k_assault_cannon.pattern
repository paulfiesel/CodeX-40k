
; ======== Assault cannon employed by Terminators, Dreadnoughts and the Razorback

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_Assault_Cannon")
	{DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(mgun)
		weaponTag(SC_rev_animation LV40k_weapon LV40k_assault_cannon)
		animationType(mgun)
		
		invSize(8 3)
		weight(100)	
		
		calibre(20)		
		aimbone(foresight3)
		curve(bullet_bolter)	; <- TEMP CURVE 
		
		reloadSpeed(15)
		fireRate(1200)	
		projectileSpeed(500)
		
		; see on SC_weapons
		recoilStrenght(Low)	
		fireMode(Auto_v6)
		
		armorPiercing(Smallarms_T8)
		healthDamage(900)
		
		minRange(140)	maxRange(140)
	)
}
