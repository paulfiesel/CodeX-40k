{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_SM_Rockets_Infantry")
	("SC_Weapon_Rocket_Launcher")
	{gravity 0.0} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(rocketlauncher)
		weaponTag(LV40k_weapon lv40k_sm_rocket_Launcher SC_laser_small)
		animationType(rocketlauncher)
		shoot_walking(Cannot)
		
		invSize(8 3)
		weight(56.0)				
		
		calibre(80) 		
		aimbone(foresight3)
		curve(gun_std) 		; <- generic curve
		
		reloadSpeed(8.0)
		
		fireRate(10)	
		
		projectileSpeed(100)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Semi_v1)
		
		armorPiercing(Bazooka_T1)
		healthDamage(20000)	
		
		minRange(160)	maxRange(160)
	)
	{parameters "krak"
		("SC_Weapon_Smallarms"
			weaponCategory(rocketlauncher)
			weaponTag(LV40k_weapon lv40k_sm_rocket_Launcher SC_laser_small)
			animationType(rocketlauncher)
			shoot_walking(Cannot)
			
			invSize(8 3)
			weight(56.0)				
			
			calibre(80) 		
			aimbone(foresight3)
			curve(gun_std) 		; <- generic curve
			
			reloadSpeed(8.0)
			
			fireRate(10)	
			
			projectileSpeed(125)
			
			; see on SC_weapons
			recoilStrenght(Extreme)	
			fireMode(Semi_v1)
			
			armorPiercing(AT_T3)
			healthDamage(45000)	
			
			minRange(160)	maxRange(160)
		)
	}
}
