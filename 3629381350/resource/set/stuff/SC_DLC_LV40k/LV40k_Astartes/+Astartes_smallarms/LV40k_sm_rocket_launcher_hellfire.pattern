
; MLRS - Dreadnought Hellfire

{from "pattern bullet"
	{cursor "ironsights/rifle"}
	{cursorReloading "carbine_reload"}
	
	("SC_Weapon_Accuracy_LV40k_SM_Rockets_Infantry")
	{gravity 0.66} {DisableRicochet}
	
	("SC_Weapon_Smallarms"
		weaponCategory(rocketlauncher)
		weaponTag(LV40k_weapon lv40k_sm_rocket_Launcher)
		animationType(rocketlauncher)
		
		invSize(8 3)
		weight(100.0)				
		
		calibre(100) 		
		aimbone(foresight3)
		curve(gun_std) 		; <- generic curve
		
		reloadSpeed(6.0)
		fireRate(10)	
		projectileSpeed(150)
		
		; see on SC_weapons
		recoilStrenght(Extreme)	
		fireMode(Burst_x2)
		
		armorPiercing(Bazooka_T1)
		healthDamage(15000)	
		
		minRange(180)	maxRange(180)
	)
	{parameters "krak"
		("SC_Weapon_Smallarms"
			weaponCategory(rocketlauncher)
			weaponTag(LV40k_weapon lv40k_sm_rocket_Launcher)
			animationType(rocketlauncher)
			
			invSize(8 3)
			weight(100.0)				
			
			calibre(100) 		
			aimbone(foresight3)
			curve(gun_std) 		; <- generic curve
			
			reloadSpeed(9.0)
			fireRate(10)	
			projectileSpeed(175)
			
			; see on SC_weapons
			recoilStrenght(Extreme)	
			fireMode(Burst_x2)
			
			armorPiercing(AT_T2)
			healthDamage(30000)	
			
			minRange(200)	maxRange(200)
		)
	}
	{RecoveryTime 0.05}
}
