{sequence "lv40k_rvn_aim_idle" {file "aim_idle"} {speed 0.6}}
{sequence "lv40k_rvn_aim_crouch" {file "crouch_idle"} {speed 0.6}}

{sequence "lv40k_rvn_death1" {file "death1"} {speed 0.6}}
{sequence "lv40k_rvn_death2" {file "death2"} {speed 0.6}}

{sequence "lv40k_rvn_melee1" {file "melee1"} {speed 0.6} {Events {16 "sc_spawn_melee_ctc"}}}
