
{animation
	{Smooth 0.0}
 
	{Sequence "rev_loop_as2" {file "fire"} {Speed 0.4}}
	{Sequence "rev_stop_as2" {file "fire"} {Speed 0.3}}
	
	{Smooth 0.4}
	
	{sequence "SC_grav_hover_down" {speed 0.35} {file "hover_up"}}
	{sequence "SC_grav_hover_up" {speed 0.35} {file "hover_up"}}
	
	{sequence "SC_grav_idle" {speed 0.29} {file "idle"}}
	
	{sequence "SC_grav_move_front" {speed 0.8} {file "idle"}}
	{sequence "SC_grav_move_back" {speed 0.5} {file "idle"}}
	
	{sequence "SC_grav_move_start" {speed 0.5} {file "start"}}
	{sequence "SC_grav_move_stop" {speed 0.5} {file "stop"}}
	
	{Smooth 0.1}
	
	{sequence "gun_b"}
}