
{animation
	{Smooth 0.0}
 
	{Sequence "rev_loop_as2" {file "fire_as2"} {Speed 0.45}}
	{Sequence "rev_stop_as2" {file "fire_as2"} {Speed 0.35}}
	
	{Smooth 0.06}
	
	{Sequence "start" {Speed 0.6}}
	{Sequence "stop" {Speed 0.6}}
	
	{Sequence "body_b" {Speed 0.6}}
	{Sequence "engine_b" {Speed 0.6}}
	
	{sequence "board" {file "/[SC_Plataform]/SC_animations/human/z_dummy.anm"}  {events {0 "board"}}}
	{sequence "board_R" {file "/[SC_Plataform]/SC_animations/human/z_dummy.anm"}  {events {0 "board_R"}}}
	{sequence "board_L" {file "/[SC_Plataform]/SC_animations/human/z_dummy.anm"}  {events {0 "board_L"}}}
		
	{sequence "open_back" {speed 0.6} {file "open_door_F"} {events {0 "open_door"}}}
	{sequence "close_back" {speed 0.6} {file "close_door_F"}}
	
	{sequence "open_doorR" {speed 0.6} {File "open_door_R"} {events {0 "open_door"}}}
	{sequence "close_DoorR" {speed 0.6} {File "Close_door_R"}}
	
	{sequence "open_doorL" {speed 0.6} {File "open_door_L"} {events {0 "open_door"}}}
	{sequence "close_DoorL" {speed 0.6} {File "Close_door_L"}}
	
	{sequence "hatch1_open_veh" {speed 0.6} {file "hatch1_open"} {events {0 "board_L"}}}
	{sequence "hatch1_close_veh" {speed 0.6} {file "hatch1_open"} {events {50 "board_L"}}}
	
	{sequence "hatch1_open" {speed 0.6}}
	{sequence "hatch2_open" {speed 0.6}}
}