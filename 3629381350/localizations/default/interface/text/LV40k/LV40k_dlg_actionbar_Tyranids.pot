msgctxt "actionbar/lv40k_human_special_ability_tyr_tervigon"
msgid "Special Ability: <c(7851A9)>Incubator</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_tervigon/action"
msgid "The Tervigon spawns a squad of 10 fresh Hormagaunts that will all die after 90s.\nRecharge time: 15 seconds."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_tervigon/usage"
msgid "<c(Red)>Beware that upon death this unit has a random chance of releasing a psychic backlash that instantly kills all Tyranids attach to it!</c>"
msgstr ""





msgctxt "actionbar/lv40k_human_special_ability_tyr_hiveguard_heal"
msgid "Special Ability: <c(7851A9)>Shieldwall</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_hiveguard_heal/usage"
msgid "Becomes temporarily disabled in order to fully regenerate it's health.\nRecharge time: 10 minutes."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_lictor_cloak"
msgid "Special Ability: <c(E0FFFF)>Infiltration</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_lictor_cloak/usage"
msgid "The lictor renders himself invisible and intangible to hunt prey. Has a small % chance of escaping upon receiving fatal wounds."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_synapse"
msgid "Passive Ability: <c(CYAN)>Synapse</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_synapse/action"
msgid "Enhances nearby lesser Tyranids through psychic link, Adds passive healing and increases damage (Lvl 2/3)."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_synapse/usage"
msgid "<c(Red)>Beware that upon death this unit has a random chance of releasing a psychic backlash that instantly kills all Tyranids attach to it!</c>"
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_prime_warrior"
msgid "Passive Ability: <c(CYAN)>Tyranid Prime</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_prime_warrior/action"
msgid "Enhances nearby lesser Tyranids through psychic link, Adds passive healing and increases damage (Lvl 2/3)."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_prime_warrior/usage"
msgid "<c(GREEN)>This lifeform has been adapted by the Hive-Mind and has no risk of releasing backlash upon death!</c>"
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_swarmlord"
msgid "Passive Ability: <c(RED)>Swarmlord</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_swarmlord/action"
msgid "The ultimate Tyranid lifeform. Enhances every single tyranid present in the map including other Synaptic Tyranids, no matter where they are."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_swarmlord/usage"
msgid "<c(Red)>Has the strongest and most devastating backlash upon death. Killing all tyranids under his control while also hurting enemy psykers.</c>"
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_hivetyrant"
msgid "Passive Ability: <c(GREEN)>Hive Tyrant</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_hivetyrant/action"
msgid "Tyranid Field Commander. Projects warp enhanced energy shields and enhances every single tyranid lifeform present in the map except for Synaptic lifeforms."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_hivetyrant/usage"
msgid "<c(Red)>Releases a devastating psychic backlash upon death. Killing 50% of all tyranids under his control.</c>"
msgstr ""




msgctxt "actionbar/lv40k_human_ravener_Place_hivenode"
msgid "Special Ability: <c(CYAN)>Deploy Hivenode!</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_ravener_Place_hivenode/usage"
msgid "The Ravener plants a seed in the ground that growns into a living creature that can defend strategic points using sporemines.\nRecharge time is 5 minutes."
msgstr ""





msgctxt "actionbar/lv40k_human_special_ability_tyr_oldoneeye"
msgid "Passive Ability: <c(RED)>Beast of Calth</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_oldoneeye/action"
msgid "A Legendary Carnifex who terrorized the citizens and combatants of Ultramar during the First Tyrannic War."
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_oldoneeye/usage"
msgid "Has a chance of surving devastating enemy blows."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_tyr_venomthrope"
msgid "Passive Ability: <c(Green)>Toxic Presence</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_tyr_venomthrope/action"
msgid "The Venomthrope produces deadly toxins are a threat to any unfortunate non-Tyranid lifeforms caught in its surroundings."
msgstr ""