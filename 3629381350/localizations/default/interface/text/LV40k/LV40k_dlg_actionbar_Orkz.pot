msgctxt "actionbar/lv40k_human_special_ability_ork_warp_shield"
msgid "Special Ability: <c(GREEN)>Weird Stuff</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_ork_warp_shield/usage"
msgid "The weirdboy protects all nearby ork infantry with Warp powered Shields that will last until they are shot down.\nRecharge time: 10 minutes."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_ork_painboy_da_juice"
msgid "Special Ability: <c(CYAN)>Spechul Juice</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_ork_painboy_da_juice/usage"
msgid "Removes all negative effects and applies damage resistance (Lvl 1/3) to all Orks in range during 30s.\nRecharge time: 2 minutes."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_ork_waaagh"
msgid "Special Ability: <c(RED)>WAAAGH!</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_ork_waaagh/usage"
msgid "Gives all nearby Orks an increase in damage (Lvl 1/3) and a small health boost. The effect lasts for about 30 seconds.\nRecharge time: 2 minutes."
msgstr ""




msgctxt "actionbar/lv40k_human_mekboy_Place_grot_turret_shootas"
msgid "Special Ability: <c(BLUE)>Shoota Turret!</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_mekboy_Place_grot_turret_shootas/usage"
msgid "Teleports a turret crewed by Grots from one of the Kroozas in orbit.\nRecharge time: 5 minutes."
msgstr ""




msgctxt "actionbar/lv40k_human_special_ability_ork_warboss"
msgid "Passive Ability: <c(RED)>DA BOSS!</c>"
msgstr ""

msgctxt "actionbar/lv40k_human_special_ability_ork_warboss/usage"
msgid "Oi iz da boss o' thiz 'ere WAAAAAAGH! The aura effect gives all nearby Orks an increase in damage (Lvl 3/3) and a passive overheal boost."
msgstr ""
