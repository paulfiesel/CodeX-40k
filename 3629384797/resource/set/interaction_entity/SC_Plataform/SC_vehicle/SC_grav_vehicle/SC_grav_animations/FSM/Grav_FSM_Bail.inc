(define "SC_FSM_BAIL_Define_Enter"
)

(define "SC_FSM_BAIL_Define_Event"
	{Ani_play "SC_grav_hover_down" -1 callback}
)

(define "SC_FSM_BAIL_Define_Exit"
	{Ani_Stop "SC_grav_hover_down"}
)

