(define "SC_FSM_MOVE_LOOP_Define_Enter"
)

(define "SC_FSM_MOVE_LOOP_Define_Event"
	{if tagged "fwd"
		{Ani_play "SC_grav_move_front" loop}
	else
		{Ani_play "SC_grav_move_back" loop}
	}
)

(define "SC_FSM_MOVE_LOOP_Define_Exit"
	{Ani_Stop "SC_grav_move_front"}
	{Ani_Stop "SC_grav_move_back"}
)

