(define "SC_FSM_BOARD_Define_Enter"
)

(define "SC_FSM_BOARD_Define_Event"
	{Ani_play "SC_grav_hover_up" callback}
)

(define "SC_FSM_BOARD_Define_Exit"
	{Ani_Stop "SC_grav_hover_up"}
)

;=============================================================================================================================
; TRANSITIONS/CALLS
;=============================================================================================================================

{on animation_end "SC_grav_hover_up"
	{delay 0.1 ""
		("SC_FSM_Define_Update_FSM" do(remove) state(BOARD))
	}
}




