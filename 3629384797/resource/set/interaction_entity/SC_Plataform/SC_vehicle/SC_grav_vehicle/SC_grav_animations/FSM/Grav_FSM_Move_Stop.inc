(define "SC_FSM_MOVE_STOP_Define_Enter"
)

(define "SC_FSM_MOVE_STOP_Define_Event"
	{Ani_play "SC_grav_move_stop" callback}
)

(define "SC_FSM_MOVE_STOP_Define_Exit"
	{Ani_Stop "SC_grav_move_stop"}
)

;=============================================================================================================================
; TRANSITIONS/CALLS
;=============================================================================================================================

{on animation_end "SC_grav_move_stop"
	{delay 0.1
		("SC_FSM_Define_Update_FSM" do(remove) state(MOVE_STOP))
	}
}




