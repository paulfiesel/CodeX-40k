		{1.0	0.28}		;// 130m 20d
		{1.5	0.03}		;// 240m 15d
	}

	{curve "autorifle"		;// automatic, semi-automatic, battle, damage 70
		{0.05	3.00}		;// 6m   210d
		{0.10	1.80}		;// 12m  126d
		{0.333	1.00}		;// 40m  70d
		{0.5	0.65}		;// 60m  46d
		{1.0	0.27}		;// 120m 19d
		{2.0	0.18}		;// 240m 13d
	}

	{curve "assaultrifle"	;// assault rifles (stg), damage 65
		{0.06	2.15}		;// 6m   140d
		{0.12	1.50}		;// 12m  98d
		{0.4	0.85}		;// 40m  55d
		{0.5	0.55}		;// 50m  36d
		{1.0	0.30}		;// 100m 20d
		{2.0	0.15}		;// 200m 10d
	}

	{curve "bullet_mg"		;// machine guns, damage 80
		{0.05	1.25}		;// 6m    100d
		{0.183	0.85}		;// 22m   68d
		{0.5	0.55}		;// 60m   44d
		{1.0	0.35}		;// 120m  28d
		{1.1	0.17}		;// 132m  13.6d
		{2.0	0.1}		;// 240m  8d
	}

	{curve "bullet_hmg"		;// heavy machine guns, damage 160
		{0.07	1.25}		;// 10m   200d
