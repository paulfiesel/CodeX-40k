;/*================ defines ================*/

(define "phrase_voice"
	{phrase
		{language "%1"}
		{voice %2}
		{sound "talk/%0/%1/%3/v%2"}
		{text_dbg "(%1) %1/%3/v%2"}
	}
)

(define "phrases"	; args: actor | language | voice | foldername
