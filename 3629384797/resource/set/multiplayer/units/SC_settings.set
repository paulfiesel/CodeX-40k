;SDL

(define "SC_squad_generic"
	{charge 
		{delay %cd}
		{interval %ci}
	}
	{tags "all doctrine %side %period"}
	{tags "%type"}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
	{level 1}
	{round_multiple 1}
	{squad_cost_factor %scf}
	{round_multiple 5.0}
	{cost %cost}
	
	{research_stage %smin}
	{research_stage_max %smax}
)

