;SDL

(define "SC_squad_generic"
	{charge 
		{delay %cd}
		{interval %ci}
	}
	{tags "all %side %period"}
	{tags "%type"}
	{tags "%t"}
	{group "%g"}
	{button "%b"}
	{level 1}
	{round_multiple 1}
	{squad_cost_factor %scf}
	{round_multiple 5.0}
)

(Define "SC_generic_call_in_unit"	{score 0} {cw 0} {cp 0})

;--------------------------------------------------------------------------------------------------
; Call-in Units Defines
;--------------------------------------------------------------------------------------------------

(Define "sc_mp_call_in_unit_no_crew_doc"
	{"%name(%side)"	("SC_squad_generic" cd(%cd) ci(%ci) d(%d) side(%side) t(%t) type(call_in) period(%period) g(%g) b(%b) scf(%scf))
		("SC_generic_call_in_unit") 
		{doctrine %d} {content "%v"} {cost %cost}}
)
(Define "sc_mp_call_in_unit_with_crew4types_doc"
	{"%name(%side)"	("SC_squad_generic" cd(%cd) ci(%ci) d(%d) side(%side) t(%t) type(call_in) period(%period) g(%g) b(%b) scf(%scf))
		("SC_generic_call_in_unit")
		{doctrine %d} {content "%v ( [SC_DLC_%package]/[mp]/%side_mp/%c1 [SC_DLC_%package]/[mp]/%side_mp/%c2 [SC_DLC_%package]/[mp]/%side_mp/%c3 [SC_DLC_%package]/[mp]/%side_mp/%c4)"}}
)

