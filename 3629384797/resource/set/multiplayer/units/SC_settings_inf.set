;SDL

(define "sc_unit_misc_settings_general"
	{basic}
	{tags "%period %side %extra_tags"}
)

(define "sc_unit_tier_cx"
	("sc_unit_misc_settings_general" period(%period) side(%side) extra_tags(sc_none))
	{cp (* 1 %cpm)}	{cw (* 1 %cwm)} {cost %cost}
)

(define "sc_inf_settings_general"
	{basic}
	{breed}
	{tags "%period %side infantry man %extra_tags"}
	;{score_factor 0.02} ;// disabled because doesn't work for doctrine points!
)

