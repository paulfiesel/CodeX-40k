{from "pattern bullet"
	;{tag "tank_gun"}
	
	{tag "weapon bullet"}
	{tag "build_in gun"}	; <- for fauna.
	
	{tag "shoot_walking shoot_walking_manual shoot_walking_ai"}
	
	{filling "SC_activator_ammo" 1}

	{Spreading
		{BurstRecoveryTime 0.01} ; time in seconds for weapon accuracy to return to normal after firing.
		{BurstAccuracy 100} 	; default value 100. Accuracy for 1st shot of burst is 100%. Lower values mean less accurate.
		{SpreadRadius 1} 		; radius of weapon accuracy in meters. Most weapon spread radius is defined in small.firearms.accuracy
		{SpreadPower 1} 		; default value 1. Higher values increase chance of bullet to go into the center of spread radius.
	}
	{inventory
		{size 1 1}
		{weight 100}
	}
	{mass 1}		
	{Automatic_ai}
	{rechargeTime 0.2}
	{recoveryTime 1.0}
 	{Speed 800}
	{gravity 0}
	
	{range 3 3}
	
	{healthDamage 0}
}