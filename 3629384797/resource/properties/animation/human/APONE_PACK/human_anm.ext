	; walk/run

	{smooth 0.25}
	; walk
	{sequence "walk_gun_up"		{speed 0.2} {resume}{events {1 "walk_gun_up"}{14 "movement_speed_walk"}{31 "movement_speed_walk"}}}
	{sequence "walk_empty_up" 	{speed 0.2} {resume}{events {1 "walk_empty_up"}{8 "movement_speed_walk"}{23 "movement_speed_walk"}}}
	{sequence "walk_strap_up"	{speed 0.2} {resume}{events {1 "walk_empty_up"}{8 "movement_speed_walk"}{23 "movement_speed_walk"}}}
	{sequence "walk_1hand"		{speed 0.45} {resume}}
	{sequence "walk_2hand"		{speed 0.2} {resume}{events {14 "movement_speed_walk"}{31 "movement_speed_walk"}}}
	{sequence "walk_corpse"		{speed 0.2} {resume} {events {20 "leg_left"} {47 "leg_right"}}}
	{sequence "corpse_move"		{speed 0.25} {resume}}

	; spot
	{sequence "walk_spot_gun_up"				{speed 0.3} {resume}{events {1 "chaswep_on2"}{15 "movement_speed_walk"}{31 "movement_speed_walk"}{46 "movement_speed_walk"}{62 "movement_speed_walk"}{76 "movement_speed_walk"}{92 "movement_speed_walk"}}}
	{sequence "walk_spot_gun_up_1"				{speed 0.3} {resume}{events {1 "chaswep_on2"}{15 "movement_speed_walk"}{31 "movement_speed_walk"}{46 "movement_speed_walk"}{62 "movement_speed_walk"}{76 "movement_speed_walk"}{92 "movement_speed_walk"}}}
	{sequence "walk_spot_gun_up_2"				{speed 0.45} {resume}{events {1 "chaswep_on2"}{11 "movement_speed_walk"}{28 "movement_speed_walk"}}}
	{sequence "walk_spot_gun_belt_up"			{speed 0.35} {resume}}
	{sequence "walk_spot_gun_half-mast_up" 		{speed 0.45} {resume}}
