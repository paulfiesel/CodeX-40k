	{sequence "walk_spot_mgun_up_1"				{speed 0.45} {resume}}
	{sequence "walk_spot_pistol_up"				{speed 0.33} {resume}{events {10 "movement_speed_walk"}{25 "movement_speed_walk"}}}
	
	{sequence "walk_giveup_1"					{speed 1.00} {resume}}
	{sequence "walk_giveup_2"					{speed 1.00} {resume}}

	; run slow
	{sequence "run_slow_empty_up" 		{speed 0.33} {resume}{events {1 "walk_empty_up"}{10 "movement_speed_walk"}{23 "movement_speed_walk"}}}
	{sequence "run_slow_gun_up" 		{speed 0.33} {smooth 0.08} {resume}{events {1 "run_slow_gun"}{11 "movement_speed_walk"}{24 "movement_speed_walk"}{38 "movement_speed_walk"}{50 "movement_speed_walk"}{63 "movement_speed_walk"}{76 "movement_speed_walk"}}}
	{sequence "run_slow_strap_up" 		{speed 0.33} {resume}{events {1 "walk_empty_up"}{10 "movement_speed_walk"}{23 "movement_speed_walk"}}}

	; run normal
	{sequence "run_empty_up"			{speed 0.35} {smooth 0.11} {resume}{events {1 "run_empty_up"}{9 "movement_speed_run"}{21 "movement_speed_run"}}}
	{sequence "run_strap_up"			{speed 0.35} {smooth 0.11} {resume}{events {1 "run_empty_up"}{9 "movement_speed_run"}{21 "movement_speed_run"}}}
	
	
	{sequence "a_jog_f_aimmed" 		{speed 0.88} {smooth 0.35}{events {1 "jog_aimmed"}{9 "movement_speed_run"}{21 "movement_speed_run"}}}
