;SDL

(Include "SC_human.inc")	

{props "SC_Plataform_prop_human"}

{props "flesh" "GEM_human" "nocover" "collectable"} ; <- BUZZ: Replace the props line with this upon update.

{Chassis "foot"

	;// animation speed = movement speed / A * animation scale 
	;// speed S (km/h) animation A (km/h) rotation R (degree/s)

	{Crawl		;// S	A	R  // Slowing A down will speed up the animation

	;	{Slow		3.5	6	180 }
	;	{Normal		4.5	7	180 }
	;	{Fast		6	9	180 }
		
		{Slow		4		5	180 }
		{Normal		5		5	180 }
		{Fast		7		5	180 }
	}
	{Swim
		{Slow		2	5	180 }
		{Normal		3	5	180 }
		{Fast		5	5	180 }
	}
	{Run
		{Sneak		5		2	360 }	; x 0.85
		{Spot		6		2	360 }	; x 0.5		// Manual TPC Zoom
		{Walk		6		2	360 }	; x 0.5
		{Slow		8		5	360 }	; x 1
		{Normal		15		10	360 }	; x 0.55	// Normal Manual
		{Fast		22		8	360 }	; x 0.33	// Manual Run	(WAS ORIGINALLY 20)
		{Bow		18		8	360 }	; x 0.55	// Manual Run in multiplayer
		
	;	{Sneak		5	2	360 }	;// mission script movement mode	
	;	{Spot		6	2	420 }	;// Manual TPC Zoom
	;	{Walk		4	1.8 600 }	;// single flick, walk mode
	;	{Slow		8	3.2	360 }	;// double flick, walk mode	
	;	{Normal		13	6.2	600 }	;// single flick, running mode	
	;	{Fast		18	5.8 600 }	;// double click, running mode
	;	{Bow		16	5.0	600 }	;// mission script movement mode
		;// When soldiers run out of stamina, they will keep the animation, just play it slower.
	}
	{Strafe
		;//			m  m+v  km/h  speed	animation up 					animation down					; m+v = mask + value for strafe counter
		;{Forth		3  2 0	6.5   3		"walk_spot_gun_up_1"		  "walk_spot_gun_down_1"}			;// 6.5 km/h move 2 km/h animation 0.37 scale --> in Run
		;{Forth		3  2 1	11.0  1 	"run_spot_gun_up" 			  "run_spot_gun_down"}
		;{Forth		8  0 0	13.2  1.2	"run_spot_gun_up" 			  "run_spot_gun_down"}
		
		{Forth		3  2 0	6.5   3		"strafe_spot_gun_up_1_slow"	""}			;// SC ANIMATION
		{Forth		3  2 1	11.0  1 	"strafe_spot_gun_up_2_fast"	""}
		{Forth		8  0 0	13.2  1.2	"strafe_spot_gun_up_2_fast"	""}
		
		{Left		4  0 0	10.5  1.22	"run_spot_back-strafe_gun_up" "run_spot_back-strafe_gun_down"}
		{Right		8  0 0	13.0  1.1	"run_spot_left-strafe_gun_up" "run_spot_left-strafe_gun_down"}
		{Back		8  0 0	10.5  1.22	"run_back_spot_gun_up" 		  "run_back_spot_gun_down"}
	}
	{Injured 1.0}		;// speed multiplier when health is below 30% of maximum || SC Modded: No speed reduction as for SC.
}

; Modded lines: 88, 117, 200, 292.

; =============================================================================================== ;

(include "abm.inc")

{extender "vitality"
	{Health
		{max		100}	;// max health
		{current	100}	;// current health
		{inc		1.0}	;// health regeneration per second
	}
	{Stamina
		{max		100}	;// max stamina
		{current	100}	;// current stamina
		
; ============================================================================================================================		
		; OLD GOH
;		{inc				;// stamina regeneration/usage per second (depending on movement mode and load)
;			;// movement_mode	load[0]		load[1]		load[2]		load[3]
;			{stay				+3			+3			+2.5		+2 }
;			{walk				+3			+3			+2.5		+2 }
;			{slow				+3			+3			+2.5		+2 }
;			{normal				+2			+2			+1.5		+1 }
;			{fast				-3			-3			-3			-3 }
;		}
;		{load					0			25			50			75}		;// equipment weight (in kg)		
; ============================================================================================================================		
		; SC PLATAFORM NEW 
		; CHANGED IN ORDER TO BALANCE WEAPONS LIKE HEAVY BOLTERS OR ORK DEFFGUNS
		{inc				;// stamina regeneration/usage per second (depending on movement mode and load)
			;// movement_mode	load[0]		load[1]		load[2]		load[3]
			{stay				+3			+3			+2.5		+1 }
			{walk				+3			+3			0			+0 }
			{slow				+3			+3			0			-1 }
			{normal				+2			+2			-3			-4 }
			{fast				-3			-3			-3			-5 }
		}
		{load					0			40			65			100}		;// equipment weight (in kg)		
; ============================================================================================================================		

		{movement_limits
			{Fast		1		10}
			{Normal		0		0 }
			{Slow		-1		-1}
		}
	}
	{Damage
		{"head"		1.3}
		{"face"		1.3}
		{"body"		0.0}
		{"chest"	1.0}
		{"hand1r"	0.80}
		{"hand2r"	0.80}
		{"hand1l"	0.80}
		{"hand2l"	0.80}
		{"foot1r"	0.80}
		{"foot2r"	0.80}
		{"foot1l"	0.80}
		{"foot2l"	0.80}
		("SC_Plataform_Human_Define_Damage_Modifiers" multiplier(1))	; // <- MODDED 
	}
	{DamageBlast	1.00}
	{DamageTPC 				;// Third person and direct control
		{"head"		1.75}
		{"face"		1.75}
		{"body"		0.0}
		{"chest"	1.0}
		{"hand1r"	0.80}
		{"hand2r"	0.80}
		{"hand1l"	0.80}
		{"hand2l"	0.80}
		{"foot1r"	0.80}
		{"foot2r"	0.80}
		{"foot1l"	0.80}
		{"foot2l"	0.80}
	}
	(mod "hardcore"
		{Damage
			{"head"		3.0}
			{"face"		3.0}
			{"chest"	2.0}
			{"body"		0.0}
			{"hand1r"	1.5}
			{"hand2r"	0.8}
			{"hand1l"	1.5}
			{"hand2l"	0.8}
			{"foot1r"	1.5}
			{"foot2r"	0.8}
			{"foot1l"	1.5}
			{"foot2l"	0.8}
			("SC_Plataform_Human_Define_Damage_Modifiers" multiplier(2.0))	; // <- MODDED 
		}
		{DamageBlast	1.2}
		{DamageTPC
			{"head"		3.0}
			{"face"		3.0}
			{"chest"	2.0}
			{"body"		0.0}
			{"hand1r"	1.5}
			{"hand2r"	1.1}
			{"hand1l"	1.5}
			{"hand2l"	1.1}
			{"foot1r"	1.5}
			{"foot2r"	1.2}
			{"foot1l"	1.5}
			{"foot2l"	1.2}
		}
	)
}

{extender "resources"
	{Resources
		{max		10}		;// max resources
		{current	10}		;// current resources
		{income		0.1}	;// resources regeneration per second
	}
}

{extender "inventory"
	{box
		{Size 8 12}
		{Weight 100}
	}
	{hand_left}
	{hand_right}
	{armor "head"
		{mask "head"}
		{bone "head"}
		{volumes "head"}
		{pierceAbsorb 20}
	}
	{armor "body"
		{mask "body"}
		{volumes "body"}
		{bone "IK_UpDown"}
		{pierceAbsorb 25}
		{HeatDamping 0.6}
	}
	{armor "accessories"
		{mask "head2"}
		{bone "head"}
		{volumes "head"}
		{pierceAbsorb 25}
	}
}

{extender "stuff"
	{item "human"}
}

{bone "foresight2"
	{speed 5}
}

{Sensor
	{Visor "eyes"
		{vision "human"}
		{bone "visor"}
	}
	{Visor "peripheral"
		{vision "human_peripheral"}
		{bone "visor"}
	}
	{Visor "hearing"
		{vision "noise_detection"}
		{bone "visor"}
	}
	{Visor "telescope"}
	{AttackZone 2.5}
	{MinRecognizeTime 0.01}
	{RecognizeTime 0.01}
	{InformRange 80 100}		;// first = AI , second = USER
}

("SC_Plataform_Human_Define_Custom_Volumes")

{volume "body"	;//stomach and chest
	{thickness 0}
	;//{tags "fire"}
}
{volume "chest"	;//stomach and chest
	{thickness 2}
	{tags "fire"}
}
{volume "head"	;//top of head/helmet covered area
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "face"	;// main head volume
	{thickness 2}
	{tags "fire"}
}
{volume "hand1r"	;//shoulder to elbow
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "hand2r"	;//elbow to hand
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "hand1l"	;//shoulder to elbow
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "hand2l"	;//elbow to hand
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "foot1r" ;//pelvus to knee
	{thickness 2}
	{able {nolook 1}}
	{tags "fire"}
}
{volume "foot2r" ;//knee to foot
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}
{volume "foot1l" ;//pelvus to knee
	{thickness 2}
	{able {nolook 1}}
	{tags "fire"}
}
{volume "foot2l" ;//knee to foot
	{thickness 2}
	{able {nolook 1}}
	{tags "no_target" "fire"}
}

{extension "human_fsm.ext"}

{mass 70}
{obstacleID "human"}
{PatherID	"human"}
{collider	"human"}

{simulation {able 1} {state 0}}
{simulatorId "human"}

{able "crew" "fight" "minimap" "personage"}
{targetClass "human"}
{targetSelector "human"}

{brain "human"
	{const "bomb/detect_explosives"	7}		;// detect explosives inside 7 meter radius
	{const "bomb/detect_grenades"	5}		;// detect grenades inside 5 meter radius
	{const "bomb/danger_zone"		3.0}	;// was at 7 / hide if danger is more than "x" meters away, otherwise run away
	{const "weapon/change_time"		1.0}	;// was at 5 / disable ai weapon switch for 5 seconds
	
	{const "fight/distance"			12.0} 	;// was at 2

	{Properties
		{advance_ratio 0.5}
		{retreat_ratio 4}
	}
}

{Weaponry
	{place "hand_right"
		{Rotate}
		{SequentialAim 0}		;// was at 1
	;	{LinkBone "right_hand"}
		{LinkBone "right_hand_bone"}		; // <- MODDED 
		{LinkAnimation "on"}
		("abm_human")
		{AimBone "aim_ref"}
	;	{Foresight "right_hand"}			; // <- MODDED 
	}
	{ManualAccuracy 1.00}
	{ManualAccuracyZoom 1.50}
	{TpcInstantAiming}
	{UseLookatAiming}
;//	{AnimatedAiming}
}

{extender "talk"
	{talker "human"}
}
{NoGroupMesh 1}
{lodclass "human"}

