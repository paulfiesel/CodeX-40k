{component "spo_indicator"}

(define "hull"
	{setting "body"
		{thickness %Body_th}
		{durability  {blast {koef 1} {value 60}} {pierce {koef 1} {value 100}}}	
		{threshold  {blast {koef 1} {value %Body_th}} {pierce {koef 1} {value %Body_th}}}
		{volumes "body*"}
	}
	{setting "wing"
		{thickness %Wing_th}
		{durability  {blast {koef 1}{value 15}} {pierce {koef 1}{value 80}}}
		{threshold  {blast {koef 1}{value %Wing_th}} {pierce {koef 1}{value %Wing_th}}}
		{volumes "wing*"}
	}
)

(define "hull_and_rotors"
	{setting "propeller" {thickness %main_rotor_th}
		{durability  {blast {value 10}} {pierce {value 50}}}
		{threshold  {blast {value %main_rotor_th}} {pierce {value %main_rotor_th}}}
		{volumes "propeller*"}
	}
	{setting "tail_rotor" {thickness %tail_rotor_th}
		{durability  {blast {value 10}} {pierce {value 40}}}
		{threshold  {blast {value %tail_rotor_th}} {pierce {value %tail_rotor_th}}}
		{volumes "tail_rotor*"}
	}
	{setting "body"
		{durability  {blast {koef 1} {value 60}} {pierce {koef 1} {value 130}}}
		{threshold  {blast {koef 1} {value 2}} {pierce {koef 1} {value 15}}}
		{volumes "body*"}
	}
	{setting "cabin" {thickness %cabin_th}
		{durability  {blast {value 20}} {pierce {value 999}}}
		{threshold  {blast {value %cabin_th}} {pierce {value 999}}}
		{volumes "cabin*"}
	}
)

(define "internal_devices"
{setting "engine" {thickness %engine_th}
{durability  {blast {value 10}} {pierce {value 15}}}
{threshold  {blast {value %engine_th}} {pierce {value %engine_th}}}		
{volumes "engine"}	
}	    
{setting "engine1" {thickness %engine_th}	
{durability  {blast {value 10}} {pierce {value 15}}}
{threshold  {blast {value %engine_th}} {pierce {value %engine_th}}}		
{volumes "engine1"}	  
}	   
{setting "engine2" {thickness %engine_th}	 
{durability  {blast {value 10}} {pierce {value 15}}}	
{threshold  {blast {value %engine_th}} {pierce {value %engine_th}}}	
