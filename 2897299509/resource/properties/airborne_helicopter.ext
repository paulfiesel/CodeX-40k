(define "air_armor"
	{armor
		("internal_devices" engine_th(%engine) mechanics_th(%mechanics) electronics_th(%electronics) fuel_th(%fuel))
		("hull_and_rotors" main_rotor_th(%main_rotor) tail_rotor_th(%tail_rotor) cabin_th(%cabin))
	}
)