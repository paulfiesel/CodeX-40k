(include "physics_generic.ext")
;SDL
game_entity

{volume "body"
	{able clear {visible} {bullet} {select} {contact_ground} {touch} {contact} {blast} {obstacle}}
	{thickness 2}
}
{volume "select"
	{able clear {select}}
	{density 0}
}
{props "wood" "stuff"}
{mass 5}

{obstacleID "construction"}
{collider "particle.small"}

{simulation {able 1}}
{constrain ground}

;{extender "stuff"
;	{item "barrel"}
;}

{body
	{permit body}
}

{lodclass "decor_small"}
