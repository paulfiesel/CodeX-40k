game_entity

{volume "body"
	{able clear {visible} {bullet} {select} {contact_ground} {touch} {contact} {blast} {obstacle}}
	{tags "water"}
	{thickness 1}
}
{volume "select"
	{able clear {select}}
	{density 0}
}
