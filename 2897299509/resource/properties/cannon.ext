;SDL
actor

(include "vehicle.ext")
(include "armor.ext")
(include "cannon_crew.ext")
(include "cannon_armor.ext")
(include "abm.inc")
(include "mobility.inc")
;(include "selection/cannon.inc" scale(1.0))

("brain_vehicle")

{PatherID "cannon.small"}
{collider "cannon"}

{targetClass "cannon_small" "ap fg"}
{targetSelector "cannon_small"}

{props "with_gun" "cannon" "standart_netting"}
{able "talk" "-emit_passangers_on_enemy"}
{lodclass "cannon"}

{sensor
	{visor "main"
		{vision "cannon_main"}
		{bone "visor"}
	}
}

{Skeleton
	{bone "hearing_bone"
		{Position 0 0 40}
	}
}

{extender "inventory"
	{box
		{Size 9 6}
		{weight 10000}
		{item "repair_kit" 3}
		{item "netting_kit" 5}
	}
}

{Weaponry
	{place "gun"
		{gunner "gunner"}
	}
}

{extender "talk"
	{talker "cannon"}
}

(define "restore_ik_time"
	{RestoreIKTime 10}
)

("body" repair(45))
("gun" repair(30) thickness(10))

{perks
	{blastwave_modifier 20.0}
}

(define "armor_cannon"
	{armor
		{setting "turret"
			{thickness %tur}
			{threshold  {blast {value %t_thr}}{pierce  {value %t_thr}}}
			{durability {blast {value %t_dur}}{pierce  {value %t_dur}}}
			{volumes "turret*"}
		}
		{setting "gun"
			{thickness %tur}
			{threshold  {blast {value (* 0.8 %t_thr)}}{pierce  {value %t_thr}}}
			{durability {blast {value (* 0.8 %t_dur)}}{pierce  {value %t_dur}}}
			{volumes "gun*"}
		}
		{setting "shield"
			{thickness %s}
			{durability
				{blast {value (* %tur 3)}}	
				{pierce {value 999}}	
			}
			{volumes "shield*"}	
		}
		{setting "wheel"
			{thickness %w}
			{volumes "wheel*"}
		}
		{setting "body"	
			{thickness %b}
			{threshold  {blast {value %t_thr}}{pierce  {value %t_thr}}}	
			{durability {blast {value %t_dur}}{pierce  {value %t_dur}}}	
			{volumes "body*"}
		}
	}
)

(define "loco_params"
	{StopTime	0.2}
	{BrakeTime	0.7}
	{TurnRadius	3}
	{TurnStart	0.8}
	{TurnStop	0.5}
	{Gears		0.35 0.5 0.7 1.0}
	{RearGears	0.33 0.5}
)

(define "loco_small"
	{locomotion
		("loco_params")
		{FallSlope  60}
		{MaxSpeed	12}	
		{StartTime	2}	
		{TurnTime	4}	
		{TurnRadius	2}	
	}
)

;///////west81+++++

(define "accuracy_by_motion_rt"
	{AccuracyByMotion
		{MaxLinearSpeed %max_linear} 
		{ByLinearSpeed %accuracy_by_linear}
		{MaxAngularSpeed %max_angular}  
		{ByAngularSpeed %accuracy_by_angular}
		{DisorderTime %disorder_time}    
		{OrderTime (* %order_time (* 0.25))}
	}
)

(define "abm_howitzer_rt"
	("accuracy_by_motion_rt"
		max_linear(15) accuracy_by_linear(0.9)
		max_angular(15) accuracy_by_angular(0.8)
		disorder_time(0.2) order_time(%rechargetime)
	)
)
