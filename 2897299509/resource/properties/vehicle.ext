					Gamespeed(%Gamespeed)
				)
	}

	("CW_fuelbag" Range(%Range) Fuelvolume(%Fuelvolume))
	("CW_speed_lev" Gamespeed(%Gamespeed))
)




(define "CW_wheels_moveparam"
	{Slow 10}												;// Slow speed. Mainly used in mission scripting
