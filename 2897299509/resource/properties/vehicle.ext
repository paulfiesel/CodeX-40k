	{StopTime		(* (* 2.625 (/ %Mass 50)) (* (/ %Realspeed 60) (/ 800 %Power)))}
	{TurnTime		(* 0.01 (/ %Turnradius %Gamespeed))}
	{TurnRadius		%Turnradius}
	{Gears			0.12 0.29 0.5 0.68 1}
	{RearGears		0.15 0.25}	
