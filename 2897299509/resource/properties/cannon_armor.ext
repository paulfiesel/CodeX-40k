(define "armor_cannon"
			{armor
			{setting "turret"	
			{thickness %tur}	
			{threshold  {blast {value %t_thr}}{pierce  {value %t_thr}}}	 
			{durability {blast {value %t_dur}}{pierce  {value %t_dur}}}	
			{volumes "turret*"}	
			}	
			{setting "gun"	
			{thickness %tur}		
			{threshold  {blast {value (* 0.3 %t_thr)}}{pierce  {value %t_thr}}}	
			{durability {blast {value (* 0.3 %t_dur)}}{pierce  {value %t_dur}}}	  
			{volumes "gun*"}	
			}	
			{setting "shield"	
			{thickness %s}			
			{durability 	
			{blast {value (* %tur 3)}}	
			{pierce {value 999}}	
			}		
			{volumes "shield*"}	
			}		
			{setting "wheel"	
			{thickness %w}		
			{volumes "wheel*"}	
			}		
			{setting "body"	
			{thickness %b}		
			{threshold  {blast {value %t_thr}}{pierce  {value %t_thr}}}	
			{durability {blast {value %t_dur}}{pierce  {value %t_dur}}}	
			{volumes "body*"}	
			}	
			}
			)

(define "armor_light"
			("armor_cannon" tur(9) t_thr(4) t_dur(10) s(9) b(9) w(9))
)

(define "armor_medium"
			("armor_cannon" tur(9) t_thr(4) t_dur(15) s(9) b(9) w(9))
)

(define "armor_heavy"
		("armor_cannon" tur(9) t_thr(4) t_dur(30) s(9) b(9) w(9))
)

(define "loco_params"
		{StopTime	0.2}
		{BrakeTime	0.7}
		{TurnRadius	3}	
		{TurnStart	0.8}
		{TurnStop	0.5}
		{Gears		0.35 0.5 0.7 1.0}	
		{RearGears	0.33 0.5}
)

(define "loco_big"
		{locomotion	
			("loco_params")
			{FallSlope  60}	
			{MaxSpeed	6}
			{StartTime	5}	
			{TurnTime	20}	
			{TurnRadius	3}
			}
)
(define "armor_cannon_cw"
		{armor
			{setting "turret"
				{thickness %body}
				{threshold  {blast {value %body_t}} {pierce  {value %body_t}}}
				{durability {blast {value %body_d}} {pierce  {value %body_d}}}	
				{volumes "turret*"}	
			}	
			{setting "gun"	
				{thickness %gun}	
				{threshold  {blast {value %gun_t}} {pierce  {value %gun_t}}}
				{durability {blast {value %gun_d}} {pierce  {value %gun_d}}}	
				{volumes "gun*"}		
			}	
			{setting "shield"	
				{thickness 5}		
				{durability 		
					{blast {value 10}}	
					{pierce {value 999}}
				}			
				{volumes "shield*"}
			}		
			{setting "wheel"
				{thickness 2}		
				{volumes "wheel*"}	
			}		
			{setting "body"	
				{thickness %body}	
				{threshold  {blast {value %body_t}} {pierce  {value %body_t}}}	
				{durability {blast {value %body_d}} {pierce  {value %body_d}}}	
				{volumes "body*"}		
			}	
			{setting "part"	
				{thickness %body}		
				{threshold  {blast {value %body_t}} {pierce  {value %body_t}}}	
				{durability {blast {value %body_d}} {pierce  {value %body_d}}}		
				{volumes "part*"}	
			}		
		}
)
("armor_cannon_cw" gun(5) gun_t(2) gun_d(2) body(6) body_t(3) body_d(10))	)
(define "cw_armor_atgm"		("armor_cannon_cw" gun(5) gun_t(2) gun_d(2) body(6) body_t(3) body_d(10))	)
(define "cw_armor_mortar"		("armor_cannon_cw" gun(7) gun_t(2) gun_d(15) body(6) body_t(3) body_d(10))	)

("cannon_durability" body(200) gun(150) wheel(100) shield(200))
("cannon_thickness" args 8)

("basic_armor" args 10)

(define "loco_carrier"
		{locomotion	
		("loco_params")	
		{FallSlope  60}	
		{MaxSpeed	14}	
		{StartTime	2}	
		{TurnTime	4}	
		{TurnRadius	2}
		}
)