{Standard
	{GlobalMaxCP 1500}
	;{StageCP 50 60 70 80 90}
	{StageCP 70 90 110 130 150}
	{SpecialCP 50}					;// airstrikes special tab
	{EmplacementCP 70}				;// buildable with engineer
	{Bots
		{StartMP	0.2 min 1000 attackerMultiplier 1.00}
		{FinishMP	0.7 attackerMultiplier 5.00}
		{CP
			{Base "0:100 120:150 360:200 480:250"} ;// seconds : CP
			{RoundMultiplier "0:0.65 2:0.8 4:0.9 6:1.0 8:1.1 12:1.2 14:1.3"} ;// games played : multiplier for CP
			{AttackMultiplier 50}
		}
		{DefenseLevel
			{level_1
				{DefenseBudgetPlayer	2.5}	;// budget it multiplied by number of flags
				{DefenseBudgetAI		3.0}	;// places defender units with bot StartMP * this factor (StartMP without attackermultiplier) for player side
				{unlock games 0 progress 0.0}	;// number of games to unlock this level, or progress in percent (campaign progress bar)
			}
			{level_2							;// once level is reached previous level values are ignored only currently level is used
				{DefenseBudgetPlayer	3}
				{DefenseBudgetAI		4.0}
				{unlock games 2 progress 0.4}
			}
			{level_3
				{DefenseBudgetPlayer	3.5}
				{DefenseBudgetAI		4.5}
				{unlock games 7 progress 0.6}
			}
		}
	}
	{PaybackFactor 0.6}		;// MP paid back when loosing solider, squad or vehicle
	{SellFactor 0.5}
	{ScavengedVehicleSellFactor 0.5}		;// captured enemy vehicle 
	{RiskFactor
		{Low
			{BotResources 1.0}
			{BotVeterancy 0}
			{Rewards 1.0}
		}
		{Standard
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.25}
		}
		{High
			{BotResources 1.0}
			{BotVeterancy 2}
			{Rewards 1.5}
		}
	}
	{Resources
			{MP ;// Manpower (generic money)
				{StartVal 4500}
				{WinGain "1:600 2:900 3:1100 4:1200 6:1300 8:1400 10:1600 11:1700 12:1750 16:1800 17:1900 18:2000 22:2100 26:2200"} ;// games played : MP gain 
				{LoseGain "1:600 4:800 12:900"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	800}
					{Ammodepot	800}
					{Bonus		1000}
					{Factory	2000}
					{Research	1000}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 5}
				{WinGain "1:5 5:10 10:15"}
				{LoseGain "1:0"}
				{MapRewards
					{Airfield	20}
				}
			}
			{AP ;// Ammo points
				{StartVal 1600}
				{WinGain "1:600 2:900 10:1100 11:1300 12:1400"}
				{LoseGain "1:500"}
				{MapRewards
					{Ammodepot	2800}
					{Factory	500}
				}
			}
			{RP ;// Research points
				{StartVal 15}
				{WinGain 4}
				{LoseGain 2}
				{MapRewards
					{Bonus		2}
					{Research	6}
				}
			}
			{Budget
				{Start "0:200 4:210 8:240 12:260 16:280 20:300"} ;// games played : starting CP of each match 
				{PointsPerSecond 0.35} ;// CP income
				{Limit 1000} ;// Max CP 
			}
	}
	{ResupplyCost
		{Human
			{NewItem 1 AP}
			{Weight 1 AP}
			{Mechanic 0.25 AP}
		}
		{Vehicles
			{Weight 1 AP}
			{Fuel 0.25 AP}
			{Resupply 0.15 AP}
			{BrokenComponent
				{body 40 % MP 1 % AP}
				{turret 20 % MP 1 % AP}
				{engine 20 % MP 1 % AP}
				{track 10 % MP 1 % AP}
				{shield 1 % MP 1 % AP}
				{other 0.5 % MP 0.5 % AP} ;// If none of the above. Required.
			}
		}
		{Support
			{Airstrikes 100 % SP}
		}
	}
}