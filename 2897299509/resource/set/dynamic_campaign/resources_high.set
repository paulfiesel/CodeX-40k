{High
	{GlobalMaxCP 1500}
	;{StageCP 50 60 70 80 90}
	{StageCP 80 100 120 140 150}
	{SpecialCP 50}					;// airstrikes special tab
	{EmplacementCP 70}				;// buildable with engineer
	{Bots
		{StartMP	1.25 min 500 attackerMultiplier 1.6}
		{FinishMP	1.25 min 500 attackerMultiplier 1.6}
		{CP
			{Base "0:100 120:150 360:200 480:250"} ;// seconds : CP
			{RoundMultiplier "0:0.65 2:0.8 4:0.9 6:1.0 8:1.1 12:1.2 14:1.3"} ;// games played : multiplier for CP
			{AttackMultiplier 50}
		}
		{DefenseLevel
			{level_1
				{DefenseBudgetPlayer	2.5}	;// budget it multiplied by number of flags
				{DefenseBudgetAI		3.0}	;// places defender units with bot StartMP * this factor (StartMP without attackermultiplier) for player side
				{unlock games 0 progress 0.0}	;// number of games to unlock this level, or progress in percent (campaign progress bar)
			}
			{level_2							;// once level is reached previous level values are ignored only currently level is used
				{DefenseBudgetPlayer	3}
				{DefenseBudgetAI		4.0}
				{unlock games 2 progress 0.4}
			}
			{level_3
				{DefenseBudgetPlayer	3.5}
				{DefenseBudgetAI		4.5}
				{unlock games 7 progress 0.6}
			}
		}
	}
	{PaybackFactor 0.7}		;// MP paid back when loosing soldier, squad or vehicle
	{SellFactor 0.5}
	{ScavengedVehicleSellFactor 0.5}		;// captured enemy vehicle 
	{RiskFactor
		{Low
			{BotResources 1.0}
			{BotVeterancy 0}
			{Rewards 1.0}
		}
		{Standard
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.25}
		}
		{High
			{BotResources 1.0}
			{BotVeterancy 2}
			{Rewards 1.5}
		}
	}
	{Resources
			{MP ;// Manpower (generic money)
				{StartVal 5000}
				{WinGain "1:700 2:1000 3:1200 4:1300 6:1400 8:1500 10:1700 11:1800 12:1900 16:2000 17:2100 18:2200 22:2300 26:2400"} ;// games played : MP gain 
				{LoseGain "1:600 4:800 12:900"}
				{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
					{Airfield	800}
					{Ammodepot	800}
					{Bonus		1000}
					{Factory	2000}
					{Research	1000}
				}
			}
			{SP ;// Special Points (airstrikes)
				{StartVal 10}
				{WinGain "1:5 5:10 10:15"}
				{LoseGain "1:5"}
				{MapRewards
					{Airfield	30}
				}
			}
			{AP ;// Ammo points
				{StartVal 1700}
				{WinGain "1:700 2:1000 10:1200 11:1300 12:1500"}
				{LoseGain "1:500"}
				{MapRewards
					{Ammodepot	2800}
					{Factory	500}
				}
			}
			{RP ;// Research points
				{StartVal 15}
				{WinGain 5}
				{LoseGain 2}
				{MapRewards
					{Bonus		3}
					{Research	6}
				}
			}
			{Budget
				{Start "0:200 4:210 8:240 12:260 16:280 20:300"} ;// games played : starting CP of each match 
				{PointsPerSecond 0.45} ;// CP income
				{Limit 1000} ;// Max CP 
			}
	}
	{ResupplyCost
		{Human
			{NewItem 1 AP}
			{Weight 1 AP}
			{Mechanic 0.25 AP}
		}
		{Vehicles
			{Weight 0.75 AP}
			{Fuel 0.2 AP}
			{Resupply 0.15 AP}
			{BrokenComponent
				{body 30 % MP 1 % AP}
				{turret 15 % MP 1 % AP}
				{engine 15 % MP 1 % AP}
				{track 10 % MP 1 % AP}
				{shield 1 % MP 1 % AP}
				{other 0.5 % MP 0.5 % AP} ;// If none of the above. Required.
			}
		}
		{Support
			{Airstrikes 100 % SP}
		}
	}
}