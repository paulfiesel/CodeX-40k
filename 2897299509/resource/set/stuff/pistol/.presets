(include "\set\small_firearms_accuracy.inc")

(define "penetration"
	{projectileDamageTable 	{25 %0} {150 %1}}
)

(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)

(define "flare_pistol"
	{tag "flare_gun flaregun"}

	{fireSound "pistol/flare"}
	{fireSoundclose "pistol/flare/3p/"}
	{range 65 70}
	{gravity 0.3}
	{calibre 1}
	{AimingTolerance 3}
	{mass 0.5}

	{spreading 10.5
		{SpreadXYRatio	2}
		{radiusFunction
			0.0		0
			1.0		1.0
			1.2		2.5
			2.5		5.0
		}
	}

	{reloadAnimBonus 117}
	{reloadSound "flare"}
	("reload time" seconds(120))

	("human health" damage(60))

	("penetration" args 0.5 0.5)
	("armor health" damage(5))

	{DisableRicochet}
	{speed 15}
)
(define "zoom_pistol"
	{thirdpersonparams inherit "human default"
		{level 1
			{linkBone	"head"	}
			{distanceset 		40}
			{distance			40}	; activation distance
			{delta		20		}		; distance delta
			{nearspace_views 	"fps_arms"	}
			{nearspace_weapon	1	}
			{camera "human_zoom1.25"}
			;{offset		0 12 4.5}
			{offset		39.6 -4.5 3.7	}
			{blur_strength 10}
			{hide_hitmarker 1}
			{forceGrass 0}
			{disable_fow 0}
			{with_owner
				{viewoff 	"head"	}
				{boneon 	"fps_arms"	}
			}
			{with_weapon
				{viewoff	"fx_light"}
				{viewon 	"fps_arms"	}
			}
			{no_grain}
			{no_rim_light}
		}
		{level 2
			{camera "human_zoom1.5"}
			{scope_vignette "/texture/common/environment/lens_effects/zoom_vignette_infantry_pistol"}
			{blur_mask "/texture/common/environment/lens_effects/zoom_vignette_infantry_01_mask"}
			{offset		1 1 3	}
			{hide_weapon 1}
			{with_owner
				{viewoff 	"fps_arms"	}
			}
			{with_weapon
				{viewon		"foresight3"}
				;{viewoff "skin"	}
				;{viewoff 	"head"	}
			}
			{hide_crosshair}
			{weapon_sway_active}
		}
	}
)